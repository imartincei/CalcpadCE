'<!-- Reusable check function that flips between `ok` and `err` CSS classes based on a utilisation ratio, the canonical pattern for engineering design checks. -->
'<h1>Design check example</h1>
#def check$(s$; f$)
	#if s$ < f$
		'<p>Design check:'s$'&le;'f$'<span class="ok">The check is satisfied ✔</span>
	#else
		'<p>Design check:'s$'&gt;'f$'<span class="err">The check is NOT satisfied ✖</span>
	#end if
#end def
'
#UI 'Stress -'σ = 200MPa
#UI 'Resistance -'f_y = 205MPa
check$(σ; f_y)
'
'Stress -'σ = 210MPa
check$(σ; f_y)
