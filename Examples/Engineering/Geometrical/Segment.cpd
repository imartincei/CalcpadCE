'<!-- Section properties of a circular segment: area, centroid, second moments of area and radii of gyration from radius and central angle. -->
'<h1>Geometrical Properties of Circular Segment</h1>
'<div style="max-width:150mm"><img style="height:120pt;" alt="segment.png" class="side" src="../../Images/mechanics/sections/segment.png"></div>
#UI 'Radius -'r = 1m
#UI 'Angle -'α = 90°
a = sqr(2*r^2*(1 - cos(α)))
h = sqr(r^2 - a^2/4)
'Area
A = r^2/2*(α/1rad - sin(α))
'Centroid
y_c = a/2
z_c = 4*r/3*(sin(α/2)^3/(α/1rad - sin(α))) - h
'Perimeter
P = α/1rad*r + a
'Second moments of area
I_y = r^4/8*(α/1rad - sin(α) + 2*sin(α)*sin(α/2)^2) - (h + z_c)^2*A
I_z = r^4/24*(3*α/1rad - 3*sin(α) - 2*sin(α)*sin(α/2)^2)
'Polar moment of area
I_x = I_y + I_z
'Radii of gyration
r_y = sqrt(I_y/A)
r_z = sqrt(I_z/A)
r_x = sqrt(I_x/A)
