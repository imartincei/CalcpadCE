'<!-- Section properties of an equilateral triangle: area, centroid, $I_x$, $I_y$, section moduli and radii of gyration in closed form. -->
'<h1>Geometrical Properties of Equilateral Triangle</h1>
'<div style="max-width:120mm"><img style="height:135pt;" alt="equilateral-triangle.png" class="side" src="../../Images/mechanics/sections/equilateral-triangle.png"></div>
#UI 'Side length -'a = 1m
'Height
h = sqr(3)/2*a
'Area
A = a*h/2
'Perimeter
P = 3*a
'Centroid
y_c = a/2
z_c = h/3
'Second moments of area
I_y = a*h^3/36
I_z = a^3*h/48
'Polar moment of area
I_x = I_y+I_z
'Torsional constant
I_t = a^4*sqr(3)/80
'Torsional section modulus
W_t = a^3/20
'Radii of gyration
r_y = sqrt(I_y/A)
r_z = sqrt(I_z/A)
r_x = sqrt(I_x/A)
