'<!-- Section properties of a channel (U) profile: area, centroid, $I_x$, $I_y$, section moduli and radii of gyration. -->
'<h1>Geometrical Properties of Channel Section</h1>
'<div style="max-width:120mm"><img style="height:150pt;" alt="channel.png" class="side" src="../../Images/mechanics/sections/channel.png"></div>
'Dimensions
#UI 'Height -'h = 20m', Web thickness -'t_w = 1m
#UI 'Flange width -'b_f = 10m', Flange thickness -'t_f = 2m
'Area
A_w = h*t_w
A_f = (b_f - t_w)*t_f
A = A_w + 2*A_f 
'Centroid
S_z = A_w*t_w/2 + A_f*(b_f+t_w)
y_c = S_z/A
z_c = h/2
'Perimeter
P = 2*(h + 2*b_f - t_w)
'Second moments of area
I_y = (b_f*h^3 - (b_f - t_w)*(h - 2*t_f)^3)/12
I_z_w = (h - 2*t_f)*t_w*(t_w^2/12 + (y_c - t_w/2)^2)
I_z_f = t_f*b_f*(b_f^2/12 + (y_c - b_f/2)^2)
I_z = I_z_w + 2*I_z_f
'Polar moment of area
I_x = I_y + I_z
'Radii of gyration
r_y = sqrt(I_y/A)
r_z = sqrt(I_z/A)
r_x = sqrt(I_x/A)
