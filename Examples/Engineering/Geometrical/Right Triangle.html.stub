<div class="calcpad-output">
 <!-- Section properties of a right triangle: area, centroid offsets, $I_x$, $I_y$, section moduli and radii of gyration in closed form. -->
 <h1>Geometrical Properties of Right Triangle</h1>
 <div style="max-width:120mm">
  <img alt="right-triangle.png" class="side" src="Images/mechanics/sections/right-triangle.png" style="height:127pt;"/>
 </div>
 <p>Side lengths</p>
 <p>
  Leg -
  <span class="eq">
   <var>a</var>
   = 2
   <i>m</i>
  </span>
  , Leg -
  <span class="eq">
   <var>b</var>
   = 1
   <i>m</i>
  </span>
 </p>
 <p>Area</p>
 <p>
  <span class="eq">
   <var>A</var>
   =
   <span class="dvc">
    <var>a</var>
    ·
    <var>b</var>
    <span class="dvl">
    </span>
    2
   </span>
   =
   <span class="dvc">
    2
    <i>m</i>
    · 1
    <i>m</i>
    <span class="dvl">
    </span>
    2
   </span>
   = 1
   <i>m</i>
   <sup class="unit">2</sup>
  </span>
 </p>
 <p>Perimeter</p>
 <p>
  <span class="eq">
   <var>P</var>
   =
   <var>a</var>
   +
   <var>b</var>
   +
   <span class="o0">
    <span class="r">√</span>
    <var>a</var>
    <sup>2</sup>
    +
    <var>b</var>
    <sup>2</sup>
   </span>
   = 2
   <i>m</i>
   + 1
   <i>m</i>
   +
   <span class="o0">
    <span class="r">√</span>
    ( 2
    <i>m</i>
    )
    <sup>2</sup>
    + 1
    <i>m</i>
    <sup>2</sup>
   </span>
   = 5.24
   <i>m</i>
  </span>
 </p>
