'<!-- Section properties of a trapezoid: area, centroid offsets, $I_x$, $I_y$, section moduli and radii of gyration from the two parallel sides and height. -->
'<h1>Geometrical Properties of Trapezoid</h1>
'<div style="max-width:130mm"><img style="height:135pt;" alt="Trapezoid.png" class="side" src="../../Images/mechanics/sections/trapezoid.png"></div>
'Dimensions
#UI 'Bottom base -'a = 2m', Top base -'b = 1m
#UI 'Height -'h = 1m
'Area
A = h*(a + b)/2
'Centroid
y_c = a/2
z_c = h*((a + 2*b)/(a + b))/3
'Perimeter
P = a + b + 2*sqr(h^2 + (b - a)^2/4)
'Second moments of area
I_y = h^3*((a^2 + 4*a*b + b^2)/(a + b))/36
I_z = h*(a + b)*(a^2 + b^2)/48
'Polar moment of area
I_x = I_y + I_z
'Radii of gyration
r_y = sqrt(I_y/A)
r_z = sqrt(I_z/A)
r_x = sqrt(I_x/A)
