     <var>b</var>
     <sup>2</sup>
     +
     <var>d</var>
     <sup>2</sup>
    </span>
    <span class="dvl">
    </span>
    2
   </span>
   =
   <span class="dvc">
    <span class="o0">
     <span class="r">√</span>
     ( 1.41
     <i>m</i>
     )
     <sup>2</sup>
     +  ( 1.41
     <i>m</i>
     )
     <sup>2</sup>
    </span>
    <span class="dvl">
    </span>
    2
   </span>
   = 1
   <i>m</i>
  </span>
 </p>
 <p>Area</p>
 <p>
  <span class="eq">
