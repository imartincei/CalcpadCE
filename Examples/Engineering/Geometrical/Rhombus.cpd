'<!-- Section properties of a rhombus from its two diagonals: area, $I_x$, $I_y$, section moduli and radii of gyration. -->
'<h1>Geometrical Properties of Rhombus</h1>
'<div style="max-width:130mm"><img style="height:135pt;" alt="rombus.png" class="side" src="../../Images/mechanics/sections/rhombus.png"></div>
'Diagonals length
#UI 'Diagonal -'b = 1.414m', Diagonal -'d = 1.414m
'Side length
a = sqrt(b^2 + d^2)/2
'Area
A = b*d/2
'Centroid
y_c = b/2
z_c = d/2
'Perimeter
P = 4*a
'Second moments of area
I_y = b*d^3/48
I_z = d*b^3/48
'Polar moment of area
I_x = I_y + I_z
'Radii of gyration
r_y = sqrt(I_y/A)
r_z = sqrt(I_z/A)
r_x = sqrt(I_x/A)
