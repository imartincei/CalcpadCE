'<!-- Section properties of an angle (L) profile: area, centroid, $I_x$, $I_y$, principal axes and radii of gyration. -->
'<h1>Geometrical Properties of Angle Section</h1>
'<div style="max-width:120mm"><img style="height:150pt;" alt="angle.png" class="side" src="../../Images/mechanics/sections/angle.png"></div>
'Dimensions
#UI 'Height -'h = 20m', Web thickness -'t_w = 2m
#UI 'Flange width -'b_f = 10m', Flange thickness -'t_f = 5m
'Area
A_w = h*t_w
A_f = (b_f - t_w)*t_f
A = A_w + A_f
'Centroid
S_z = A_w*t_w/2 + A_f*(b_f + t_w)/2
y_c = S_z/A
S_y = A_w*h/2 + A_f*t_f/2
z_c = S_y/A
'Perimeter
P = 2*(h + b_f)
'Second moments of area
I_y_w = A_w*(h^2/12 + (z_c - h/2)^2)
I_y_f = A_f*(t_f^2/12 + (z_c - t_f/2)^2)
I_y = I_y_w + I_y_f
I_z_w = (h - t_f)*t_w*(t_w^2/12 + (y_c - t_w/2)^2)
I_z_f = t_f*b_f*(b_f^2/12 + (y_c - b_f/2)^2)
I_z = I_z_w + I_z_f
I_yz = A_w*(h/2 - z_c)*(t_w/2 - y_c) + A_f*(t_f/2 - z_c)*((b_f + t_w)/2 - y_c)
'Principal moments of area
I_1 = (I_y + I_z)/2 + sqrt((I_y - I_z)^2/4 + I_yz^2)
I_2 = (I_y + I_z)/2 - sqrt((I_y - I_z)^2/4 + I_yz^2)
'Angle of principal axis
α_1 = atan((I_y - I_1)/I_yz)
'Polar moment of area
I_x = I_1 + I_2
'Radii of gyration
r_y = sqrt(I_y/A)
r_z = sqrt(I_z/A)
r_1 = sqrt(I_1/A)
r_2 = sqrt(I_2/A)
r_x = sqrt(I_x/A)
