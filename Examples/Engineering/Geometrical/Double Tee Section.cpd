'<!-- Section properties of a Double Tee (I-beam) profile: area, centroid, $I_x$, $I_y$, section moduli and radii of gyration. -->
'<h1>Geometrical Properties of Double Tee Section</h1>
'<div style="max-width:150mm"><img style="height:165pt;" alt="double-tee.png" class="side" src="../../Images/mechanics/sections/double-tee.png"></div>
'Dimensions
#UI 'Height -'h = 20m', Web thickness -'t_w = 1m
#UI 'Bottom flange width -'b_f1 = 10m', Bottom flange thickness -'t_f1 = 2m
#UI 'Top flange width -'b_f2 = 15m', Top flange thickness -'t_f2 = 3m
'Area
A_w = h*t_w
A_f1 = (b_f1 - t_w)*t_f1
A_f2 = (b_f2 - t_w)*t_f2
A = A_w + A_f1 + A_f2
'Centroid
y_c = max(b_f1; b_f2)/2 
S_y = A_w*h/2 + A_f1*t_f1/2 + A_f2*(h - t_f2/2)
z_c = S_y/A
'Perimeter
P = 2*(h + b_f1 + b_f2 - t_w)
'Second moments of area
I_y_w = A_w*(h^2/12 +(z_c - h/2)^2)
I_y_f1 = A_f1*(t_f1^2/12 + (z_c - t_f1/2)^2)
I_y_f2 = A_f2*(t_f2^2/12 + (h - z_c - t_f2/2)^2)
I_y = I_y_w + I_y_f1 + I_y_f2
I_z = (t_f1*b_f1^3 + t_f2*b_f2^3 + (h - t_f1 - t_f2)*t_w^3)/12
'Polar moment of area
I_x = I_y + I_z
'Radii of gyration
r_y = sqrt(I_y/A)
r_z = sqrt(I_z/A)
r_x = sqrt(I_x/A)
