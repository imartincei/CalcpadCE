'<!-- Section properties of a Double Tee (I-beam) profile: area, centroid, $I_x$, $I_y$, section moduli and radii of gyration. -->
"Geometrical Properties of Double Tee Section
'<div style="max-width:150mm"><img style="height:165pt;" alt="double-tee.png" class="side" src="../../Images/mechanics/sections/double-tee.png"></div>
'Dimensions
h = ? {20}'m,'t_w = ? {1}'m
b_f1 = ? {10}'m,'t_f1 = ? {2}'m
b_f2 = ? {15}'m,'t_f2 = ? {3}'m
'Area
A_w = h*t_w'm<sup>2</sup>
A_f1 = (b_f1 - t_w)*t_f1'm<sup>2</sup>
A_f2 = (b_f2 - t_w)*t_f2'm<sup>2</sup>
A = A_w + A_f1 + A_f2'm<sup>2</sup>
'Centroid
y_c = max(b_f1; b_f2)/2 'm
S_y = A_w*h/2 + A_f1*t_f1/2 + A_f2*(h - t_f2/2)'m<sup>3</sup>
z_c = S_y/A'm
'Perimeter
P = 2*(h + b_f1 + b_f2 - t_w)'m
'Second moments of area
I_y_w = A_w*(h^2/12 +(z_c - h/2)^2)'m<sup>4</sup>
I_y_f1 = A_f1*(t_f1^2/12 + (z_c - t_f1/2)^2)'m<sup>4</sup>
I_y_f2 = A_f2*(t_f2^2/12 + (h - z_c - t_f2/2)^2)'m<sup>4</sup>
I_y = I_y_w + I_y_f1 + I_y_f2'm<sup>4</sup>
I_z = (t_f1*b_f1^3 + t_f2*b_f2^3 + (h - t_f1 - t_f2)*t_w^3)/12'm<sup>4</sup>
'Polar moment of area
I_x = I_y + I_z'm<sup>4</sup>
'Radii of gyration
r_y = sqrt(I_y/A)'m
r_z = sqrt(I_z/A)'m
r_x = sqrt(I_x/A)'m
