'<!-- Section properties of a rectangular hollow section (RHS): area, $I_x$, $I_y$, section moduli and radii of gyration from outer and inner dimensions. -->
'<h1>Geometrical Properties of Rectangular Tube</h1>
'<div style="max-width:150mm"><img style="height:150pt;" alt="rectangular-tube.png" class="side" src="../../Images/mechanics/sections/rectangular-tube.png"></div>
'Dimensions
#UI 'Height -'h = 300m', Web thickness -'t_w = 20m
#UI 'Width -'b = 200m', Flange thickness -'t_f = 30m
b_1 = b - 2*t_w
h_1 = h - 2*t_f
'Area
A = 2*(h*t_w + b_1*t_f)
A = h*b - h_1*b_1
'Centroid
y_c = b/2
z_c = h/2
'Perimeter
P = 2*(h + b)
'Second moments of area
I_y = (b*h^3 - b_1*h_1^3)/12
I_z = (b^3*h - b_1^3*h_1)/12
'Polar moment of area
I_x = I_y + I_z
'Radii of gyration
r_y = sqrt(I_y/A)
r_z = sqrt(I_z/A)
r_x = sqrt(I_x/A)
