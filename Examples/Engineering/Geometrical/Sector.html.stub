     <sub>z</sub>
     <span class="dvl">
     </span>
     <var>A</var>
    </span>
   </span>
   =
   <span class="o1">
    <span class="r1">
    </span>
    <span class="dvc">
     0.0713
     <i>m</i>
     <sup class="unit">4</sup>
     <span class="dvl">
     </span>
     0.785
     <i>m</i>
     <sup class="unit">2</sup>
    </span>
