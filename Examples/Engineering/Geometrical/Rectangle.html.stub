<div class="calcpad-output">
 <!-- Section properties of a rectangle: area, $I_x = b h^3 / 12$, $I_y = h b^3 / 12$, section moduli and radii of gyration. -->
 <h1>Geometrical Properties of Rectangle</h1>
 <div style="max-width:120mm">
  <img alt="rectangle.png" class="side" src="Images/mechanics/sections/rectangle.png" style="height:150pt;"/>
 </div>
 <p>Dimensions</p>
 <p>
  Height -
  <span class="eq">
   <var>h</var>
   = 2
   <i>m</i>
  </span>
  , Width -
  <span class="eq">
   <var>b</var>
   = 1
   <i>m</i>
  </span>
 </p>
 <p>Area</p>
 <p>
  <span class="eq">
   <var>A</var>
   =
   <var>h</var>
   ·
   <var>b</var>
   = 2
   <i>m</i>
   · 1
   <i>m</i>
   = 2
   <i>m</i>
   <sup class="unit">2</sup>
  </span>
 </p>
 <p>Centroid</p>
 <p>
  <span class="eq">
   <var>y</var>
   <sub>c</sub>
   =
   <span class="dvc">
    <var>b</var>
    <span class="dvl">
    </span>
    2
   </span>
   =
   <span class="dvc">
    1
    <i>m</i>
    <span class="dvl">
    </span>
    2
   </span>
   = 0.5
   <i>m</i>
  </span>
 </p>
 <p>
  <span class="eq">
   <var>z</var>
   <sub>c</sub>
   =
   <span class="dvc">
    <var>h</var>
    <span class="dvl">
    </span>
    2
   </span>
   =
   <span class="dvc">
    2
    <i>m</i>
    <span class="dvl">
    </span>
    2
   </span>
   = 1
   <i>m</i>
  </span>
 </p>
 <p>Perimeter</p>
 <p>
  <span class="eq">
   <var>P</var>
   = 2 ·  (
   <var>h</var>
   +
   <var>b</var>
   )  = 2 ·  ( 2
   <i>m</i>
   + 1
   <i>m</i>
   )  = 6
   <i>m</i>
  </span>
 </p>
 <p>Second moments of area</p>
 <p>
  <span class="eq">
   <var>I</var>
   <sub>y</sub>
   =
   <span class="dvc">
    <var>b</var>
    ·
    <var>h</var>
    <sup>3</sup>
    <span class="dvl">
    </span>
    12
   </span>
   =
   <span class="dvc">
    1
    <i>m</i>
    ·  ( 2
    <i>m</i>
    )
    <sup>3</sup>
    <span class="dvl">
    </span>
    12
   </span>
   = 0.667
   <i>m</i>
   <sup class="unit">4</sup>
  </span>
 </p>
 <p>
  <span class="eq">
   <var>I</var>
   <sub>z</sub>
   =
   <span class="dvc">
    <var>b</var>
    <sup>3</sup>
    ·
    <var>h</var>
    <span class="dvl">
    </span>
    12
   </span>
   =
   <span class="dvc">
    1
    <i>m</i>
    <sup>3</sup>
    · 2
    <i>m</i>
    <span class="dvl">
    </span>
    12
   </span>
   = 0.167
   <i>m</i>
   <sup class="unit">4</sup>
  </span>
 </p>
 <p>Polar moment of area</p>
 <p>
  <span class="eq">
   <var>I</var>
   <sub>x</sub>
   =
   <var>I</var>
   <sub>y</sub>
   +
   <var>I</var>
   <sub>z</sub>
   = 0.667
   <i>m</i>
   <sup class="unit">4</sup>
   + 0.167
   <i>m</i>
   <sup class="unit">4</sup>
   = 0.833
   <i>m</i>
   <sup class="unit">4</sup>
  </span>
 </p>
 <p>Radii of gyration</p>
 <p>
  <span class="eq">
   <var>r</var>
   <sub>y</sub>
   =
   <span class="o1">
    <span class="r1">
    </span>
    <span class="dvc">
     <var>I</var>
     <sub>y</sub>
     <span class="dvl">
     </span>
     <var>A</var>
    </span>
   </span>
   =
   <span class="o1">
    <span class="r1">
    </span>
    <span class="dvc">
     0.667
     <i>m</i>
     <sup class="unit">4</sup>
     <span class="dvl">
     </span>
     2
     <i>m</i>
     <sup class="unit">2</sup>
    </span>
   </span>
   = 0.577
   <i>m</i>
  </span>
 </p>
 <p>
  <span class="eq">
   <var>r</var>
   <sub>z</sub>
   =
   <span class="o1">
    <span class="r1">
    </span>
    <span class="dvc">
     <var>I</var>
     <sub>z</sub>
     <span class="dvl">
     </span>
     <var>A</var>
    </span>
   </span>
   =
   <span class="o1">
    <span class="r1">
    </span>
    <span class="dvc">
     0.167
     <i>m</i>
     <sup class="unit">4</sup>
     <span class="dvl">
     </span>
     2
     <i>m</i>
     <sup class="unit">2</sup>
    </span>
   </span>
   = 0.289
   <i>m</i>
  </span>
 </p>
 <p>
  <span class="eq">
   <var>r</var>
   <sub>x</sub>
   =
   <span class="o1">
    <span class="r1">
    </span>
    <span class="dvc">
     <var>I</var>
     <sub>x</sub>
     <span class="dvl">
     </span>
     <var>A</var>
    </span>
   </span>
   =
   <span class="o1">
    <span class="r1">
    </span>
    <span class="dvc">
     0.833
     <i>m</i>
     <sup class="unit">4</sup>
     <span class="dvl">
     </span>
     2
     <i>m</i>
     <sup class="unit">2</sup>
    </span>
   </span>
   = 0.645
   <i>m</i>
  </span>
 </p>
 <p>Torsional constant</p>
 <p>
  <span class="eq">
   <var>I</var>
   <sub>t</sub>
   =
   <span class="dvc up">
    <var>h</var>
    ·
    <var>b</var>
    <sup>3</sup>
    ·
    <span class="b1">(</span>
    1 −
    <span class="dvc">
     0.63 ·
     <var>b</var>
     <span class="dvl">
     </span>
     <var>h</var>
    </span>
    + 0.052 ·
    <span class="b1">(</span>
    <span class="dvc">
     <var>b</var>
     <span class="dvl">
     </span>
     <var>h</var>
    </span>
    <span class="b1">)</span>
    <sup class="raised">5</sup>
    <span class="b1">)</span>
    <span class="dvl">
    </span>
    3
   </span>
   =
   <span class="dvc up">
    2
    <i>m</i>
    · 1
    <i>m</i>
    <sup>3</sup>
    ·
    <span class="b1">(</span>
    1 −
    <span class="dvc">
     0.63 · 1
     <i>m</i>
     <span class="dvl">
     </span>
     2
     <i>m</i>
    </span>
    + 0.052 ·
    <span class="b1">(</span>
    <span class="dvc">
     1
     <i>m</i>
     <span class="dvl">
     </span>
     2
     <i>m</i>
    </span>
    <span class="b1">)</span>
    <sup class="raised">5</sup>
    <span class="b1">)</span>
    <span class="dvl">
    </span>
    3
   </span>
   = 0.458
   <i>m</i>
   <sup class="unit">4</sup>
  </span>
 </p>
 <p>Torsional section modulus</p>
 <p>
  <span class="eq">
   <var>W</var>
   <sub>t</sub>
   =
   <span class="dvc up">
    <var>h</var>
    ·
    <var>b</var>
    <sup>2</sup>
    ·
    <span class="b1">(</span>
    1 −
    <span class="dvc">
     0.63 ·
     <var>b</var>
     <span class="dvl">
     </span>
     <var>h</var>
    </span>
    + 0.25 ·
    <span class="b1">(</span>
    <span class="dvc">
     <var>b</var>
     <span class="dvl">
     </span>
     <var>h</var>
    </span>
    <span class="b1">)</span>
    <sup class="raised">2</sup>
    <span class="b1">)</span>
    <span class="dvl">
    </span>
    3
   </span>
   =
   <span class="dvc up">
    2
    <i>m</i>
    · 1
    <i>m</i>
    <sup>2</sup>
    ·
    <span class="b1">(</span>
    1 −
    <span class="dvc">
     0.63 · 1
     <i>m</i>
     <span class="dvl">
     </span>
     2
     <i>m</i>
    </span>
    + 0.25 ·
    <span class="b1">(</span>
    <span class="dvc">
     1
     <i>m</i>
     <span class="dvl">
     </span>
     2
     <i>m</i>
    </span>
    <span class="b1">)</span>
    <sup class="raised">2</sup>
    <span class="b1">)</span>
    <span class="dvl">
    </span>
