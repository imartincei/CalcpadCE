'<!-- Section properties of a rectangle: area, $I_x = b h^3 / 12$, $I_y = h b^3 / 12$, section moduli and radii of gyration. -->
'<h1>Geometrical Properties of Rectangle</h1>
'<div style = "max-width:120mm"><img style="height:150pt;" alt="rectangle.png" class="side" src="../../Images/mechanics/sections/rectangle.png"></div>
'Dimensions
#UI 'Height -'h = 2m', Width -'b = 1m
'Area
A = h*b
'Centroid
y_c = b/2
z_c = h/2
'Perimeter
P = 2*(h + b)
'Second moments of area
I_y = b*h^3/12
I_z = b^3*h/12
'Polar moment of area
I_x = I_y + I_z
'Radii of gyration
r_y = sqrt(I_y/A)
r_z = sqrt(I_z/A)
r_x = sqrt(I_x/A)
#if '<!--'h ≡ b'-->'
'Torsional constant
I_t = 0.1406*h^4
'Torsional section modulus
W_t = 0.2080*h^3
#else
#if '<!--'h > b'-->'
'Torsional constant
I_t = h*b^3*(1 - 0.630*b/h + 0.052*(b/h)^5)/3
'Torsional section modulus
W_t = h*b^2*(1 - 0.630*b/h + 0.250*(b/h)^2)/3
#else
'Torsional constant
I_t = b*h^3*(1 - 0.630*h/b + 0.052*(h/b)^5)/3
'Torsional section modulus
W_t = b*h^2*(1 - 0.630*h/b + 0.250*(h/b)^2)/3
#end if
#end if
