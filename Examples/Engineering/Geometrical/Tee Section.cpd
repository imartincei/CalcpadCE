'<!-- Section properties of a Tee profile: area, centroid, second moments of area $I_x$, $I_y$, section moduli and radii of gyration. -->
'<h1>Geometrical Properties of Tee Section</h1>
'<div style="max-width:120mm"><img style="height:150pt;" alt="tee.png" class="side" src="../../Images/mechanics/sections/tee.png"></div>
'Dimensions
#UI 'Height -'h = 20m', Web thickness -'t_w = 2m
#UI 'Flange width -'b_f = 10m', Flange thickness -'t_f = 5m
'Area
A_w = h*t_w
A_f = (b_f - t_w)*t_f
A = A_w + A_f
'Centroid
y_c = b_f/2
S_y = A_w*h/2 + A_f*(h - t_f/2)
z_c = S_y/A
'Perimeter
P = 2*(h + b_f)
'Second moments of area
I_y_w = A_w*(h^2/12 +(z_c - h/2)^2)
I_y_f = A_f*(t_f^2/12 + (h - z_c - t_f/2)^2)
I_y = I_y_w + I_y_f
I_z = (t_f*b_f^3 + (h - t_f)*t_w^3)/12
'Polar moment of area
I_x = I_y + I_z
'Radii of gyration
r_y = sqrt(I_y/A)
r_z = sqrt(I_z/A)
r_x = sqrt(I_x/A)
