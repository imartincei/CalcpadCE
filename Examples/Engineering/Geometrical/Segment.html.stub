   <var>z</var>
   <sub>c</sub>
   )
   <sup>2</sup>
   ·
   <var>A</var>
   =
   <span class="dvc">
    1
    <i>m</i>
    <sup>4</sup>
    <span class="dvl">
    </span>
    8
   </span>
   ·
   <span class="b1">(</span>
   <span class="dvc">
    90°
    <span class="dvl">
    </span>
    1
    <i>rad</i>
   </span>
   −
   <b>sin</b>
   ( 90° )  + 2 ·
   <b>sin</b>
   ( 90° )  ·
   <b>sin</b>
   <span class="b1">(</span>
   <span class="dvc">
    90°
    <span class="dvl">
    </span>
    2
   </span>
   <span class="b1">)</span>
   <sup class="raised">2</sup>
   <span class="b1">)</span>
   −  ( 0.707
   <i>m</i>
   + 0.119
   <i>m</i>
   )
   <sup>2</sup>
   · 0.285
   <i>m</i>
   <sup class="unit">2</sup>
   = 0.00169
   <i>m</i>
   <sup class="unit">4</sup>
  </span>
 </p>
 <p>
  <span class="eq">
   <var>I</var>
   <sub>z</sub>
   =
   <span class="dvc">
    <var>r</var>
    <sup>4</sup>
    <span class="dvl">
    </span>
    24
   </span>
