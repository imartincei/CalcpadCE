<div class="calcpad-output">
 <!-- Section properties of a circular segment: area, centroid, second moments of area and radii of gyration from radius and central angle. -->
 <h1>Geometrical Properties of Circular Segment</h1>
 <div style="max-width:150mm">
  <img alt="segment.png" class="side" src="Images/mechanics/sections/segment.png" style="height:120pt;"/>
 </div>
 <p>
  Radius -
  <span class="eq">
   <var>r</var>
   = 1
   <i>m</i>
  </span>
 </p>
 <p>
  Angle -
  <span class="eq">
   <var>α</var>
   = 90°
  </span>
 </p>
 <p>
  <span class="eq">
   <var>a</var>
   =
   <span class="o0">
    <span class="r">√</span>
    2 ·
    <var>r</var>
    <sup>2</sup>
    ·  ( 1 −
    <b>cos</b>
    (
    <var>α</var>
    )  )
   </span>
   =
   <span class="o0">
    <span class="r">√</span>
    2 · 1
    <i>m</i>
    <sup>2</sup>
    ·  ( 1 −
    <b>cos</b>
    ( 90° )  )
   </span>
   = 1.41
   <i>m</i>
  </span>
 </p>
 <p>
  <span class="eq">
   <var>h</var>
   =
   <span class="o1">
    <span class="r1">
    </span>
    <var>r</var>
    <sup>2</sup>
    −
    <span class="dvc">
     <var>a</var>
     <sup>2</sup>
     <span class="dvl">
     </span>
     4
    </span>
   </span>
   =
   <span class="o1">
    <span class="r1">
    </span>
    1
    <i>m</i>
    <sup>2</sup>
    −
    <span class="dvc">
     ( 1.41
     <i>m</i>
     )
     <sup>2</sup>
     <span class="dvl">
     </span>
     4
    </span>
   </span>
   = 0.707
   <i>m</i>
  </span>
 </p>
 <p>Area</p>
 <p>
  <span class="eq">
   <var>A</var>
   =
   <span class="dvc">
    <var>r</var>
    <sup>2</sup>
    <span class="dvl">
    </span>
    2
   </span>
   ·
   <span class="b1">(</span>
   <span class="dvc">
    <var>α</var>
    <span class="dvl">
    </span>
    1
    <i>rad</i>
   </span>
   −
   <b>sin</b>
   (
   <var>α</var>
   )
   <span class="b1">)</span>
   =
   <span class="dvc">
    1
    <i>m</i>
    <sup>2</sup>
    <span class="dvl">
    </span>
    2
   </span>
   ·
   <span class="b1">(</span>
   <span class="dvc">
    90°
    <span class="dvl">
    </span>
    1
    <i>rad</i>
   </span>
   −
   <b>sin</b>
   ( 90° )
   <span class="b1">)</span>
   = 0.285
   <i>m</i>
   <sup class="unit">2</sup>
  </span>
 </p>
 <p>Centroid</p>
 <p>
  <span class="eq">
   <var>y</var>
   <sub>c</sub>
   =
   <span class="dvc">
    <var>a</var>
    <span class="dvl">
    </span>
    2
   </span>
   =
   <span class="dvc">
    1.41
    <i>m</i>
    <span class="dvl">
    </span>
    2
   </span>
   = 0.707
   <i>m</i>
  </span>
 </p>
 <p>
  <span class="eq">
   <var>z</var>
   <sub>c</sub>
   =
   <span class="dvc">
    4 ·
    <var>r</var>
    <span class="dvl">
    </span>
    3
   </span>
   ·
   <span class="dvc">
    <b>sin</b>
    <span class="b1">(</span>
    <span class="dvc">
     <var>α</var>
     <span class="dvl">
     </span>
     2
    </span>
    <span class="b1">)</span>
    <sup class="raised">3</sup>
    <span class="dvl">
    </span>
    <span class="dvc">
     <var>α</var>
     <span class="dvl">
     </span>
     1
     <i>rad</i>
    </span>
    −
    <b>sin</b>
    (
    <var>α</var>
