 <div style="max-width:80mm;">
  <img alt="square.png" class="side" src="Images/math/area/square.png" style="height:60pt;"/>
 </div>
 <p>
  Side length -
  <span class="eq">
   <var>a</var>
   = 1
   <i>m</i>
  </span>
 </p>
 <p>Area</p>
 <p>
  <span class="eq">
   <var>A</var>
   =
   <var>a</var>
   <sup>2</sup>
   = 1
   <i>m</i>
   <sup>2</sup>
   = 1
   <i>m</i>
   <sup class="unit">2</sup>
  </span>
 </p>
 <p>Perimeter</p>
 <p>
  <span class="eq">
   <var>P</var>
   = 4 ·
   <var>a</var>
   = 4 · 1
   <i>m</i>
   = 4
   <i>m</i>
  </span>
 </p>
 <p>
