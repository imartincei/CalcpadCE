<div class="calcpad-output">
 <!-- Area $A = \pi d^2/4$ and circumference $P = \pi d$ of a circle, parameterised by diameter. -->
 <div style="max-width:100mm;">
  <img alt="circle.png" class="side" src="Images/math/area/circle.png" style="height:70pt;"/>
 </div>
 <p>
  Diameter -
  <span class="eq">
   <var>d</var>
   = 1
   <i>m</i>
  </span>
 </p>
 <p>Area</p>
 <p>
  <span class="eq">
   <var>A</var>
   =
   <span class="dvc">
    <var>π</var>
    ·
    <var>d</var>
    <sup>2</sup>
    <span class="dvl">
    </span>
    4
   </span>
   =
   <span class="dvc">
    3.14 · 1
    <i>m</i>
    <sup>2</sup>
    <span class="dvl">
    </span>
    4
   </span>
   = 0.785
   <i>m</i>
   <sup class="unit">2</sup>
  </span>
 </p>
 <p>Circumference</p>
 <p>
  <span class="eq">
   <var>P</var>
   =
   <var>π</var>
   ·
   <var>d</var>
   = 3.14 · 1
   <i>m</i>
   = 3.14
   <i>m</i>
  </span>
 </p>
 <p>
 </p>
</div>
