<div class="calcpad-output">
 <!-- Area and arc length of a circular sector specified by its chord and height instead of the central angle. -->
 <h1>Area and Arch Length of Circular Sector</h1>
 <div style="max-width:110mm;">
  <img alt="sector-chord.png" class="side" src="Images/math/area/sector-chord.png" style="height:60pt;"/>
 </div>
 <p>
  Radius -
  <span class="eq">
   <var>r</var>
   = 1
   <i>m</i>
  </span>
 </p>
 <p>
  Chord -
  <span class="eq">
   <var>a</var>
   = 1
   <i>m</i>
  </span>
 </p>
 <!--
<-->
 <p>Angle</p>
 <p>
  <span class="eq">
   <var>α</var>
   = 2 ·
   <b>asin</b>
   <span class="b1">(</span>
   <span class="dvc">
    <var>a</var>
    <span class="dvl">
    </span>
    2 ·
    <var>r</var>
   </span>
   <span class="b1">)</span>
   = 2 ·
   <b>asin</b>
   <span class="b1">(</span>
   <span class="dvc">
    1
    <i>m</i>
    <span class="dvl">
    </span>
    2 · 1
    <i>m</i>
   </span>
   <span class="b1">)</span>
   = 60°
  </span>
 </p>
 <p>Area</p>
 <p>
  <span class="eq">
   <var>A</var>
   =
   <span class="dvc">
    <var>π</var>
    ·
    <var>r</var>
    <sup>2</sup>
    ·
    <var>α</var>
    <span class="dvl">
    </span>
    360°
   </span>
   =
   <span class="dvc">
    3.14 · 1
    <i>m</i>
    <sup>2</sup>
    · 60°
    <span class="dvl">
    </span>
    360°
   </span>
   = 0.524
   <i>m</i>
   <sup class="unit">2</sup>
  </span>
 </p>
 <p>Arch length</p>
 <p>
  <span class="eq">
   <var>S</var>
   =
   <span class="dvc">
    <var>π</var>
    ·
    <var>r</var>
    ·
    <var>α</var>
    <span class="dvl">
    </span>
    180°
   </span>
   =
   <span class="dvc">
    3.14 · 1
    <i>m</i>
    · 60°
    <span class="dvl">
    </span>
    180°
   </span>
   = 1.05
   <i>m</i>
  </span>
 </p>
 <!--
<-->
</div>
