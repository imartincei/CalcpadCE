<div class="calcpad-output">
 <!-- Area and perimeter of a general triangle from three side lengths via Heron formula, with a triangle-inequality guard. -->
 <div style="max-width:110mm;">
  <img alt="triangle.png" class="side" src="Images/math/area/triangle.png" style="height:55pt;"/>
 </div>
 <p>Side lengths</p>
 <p>
  Side a -
  <span class="eq">
   <var>a</var>
   = 5
   <i>m</i>
  </span>
  , Side b -
  <span class="eq">
   <var>b</var>
   = 4
   <i>m</i>
  </span>
  , Side c -
  <span class="eq">
   <var>c</var>
   = 3
   <i>m</i>
  </span>
 </p>
 <!--
<-->
 <p>Perimeter</p>
 <p>
  <span class="eq">
   <var>P</var>
   =
   <var>a</var>
   +
   <var>b</var>
   +
   <var>c</var>
   = 5
   <i>m</i>
   + 4
   <i>m</i>
   + 3
   <i>m</i>
   = 12
   <i>m</i>
  </span>
 </p>
 <p>Area (Heron formula)</p>
 <p>
  Semiperimeter -
  <span class="eq">
   <var>p</var>
   = 0.5 ·
   <var>P</var>
   = 0.5 · 12
   <i>m</i>
   = 6
   <i>m</i>
  </span>
 </p>
 <p>
  <span class="eq">
   <var>A</var>
   =
   <span class="o0">
    <span class="r">√</span>
    <var>p</var>
    ·  (
    <var>p</var>
    −
    <var>a</var>
    )  ·  (
    <var>p</var>
    −
    <var>b</var>
    )  ·  (
    <var>p</var>
    −
    <var>c</var>
    )
   </span>
   =
   <span class="o0">
    <span class="r">√</span>
    6
    <i>m</i>
    ·  ( 6
    <i>m</i>
    − 5
    <i>m</i>
    )  ·  ( 6
    <i>m</i>
    − 4
    <i>m</i>
    )  ·  ( 6
    <i>m</i>
    − 3
    <i>m</i>
    )
   </span>
   = 6
   <i>m</i>
   <sup class="unit">2</sup>
  </span>
 </p>
 <!--
<-->
</div>
