<div class="calcpad-output">
 <!-- Area $A = a\, b$ and perimeter $P = 2(a + b)$ of a rectangle from its two side lengths. -->
 <div style="max-width:100mm;">
  <img alt="rectangle.png" class="side" src="Images/math/area/rectangle.png" style="height:55pt;"/>
 </div>
 <p>Dimensions</p>
 <p>
  Length -
  <span class="eq">
   <var>a</var>
   = 2
   <i>m</i>
  </span>
  , Width -
  <span class="eq">
   <var>b</var>
   = 1
   <i>m</i>
  </span>
 </p>
 <p>Area</p>
 <p>
  <span class="eq">
   <var>A</var>
   =
   <var>a</var>
   ·
   <var>b</var>
   = 2
   <i>m</i>
   · 1
   <i>m</i>
   = 2
   <i>m</i>
   <sup class="unit">2</sup>
  </span>
 </p>
 <p>Perimeter</p>
 <p>
  <span class="eq">
   <var>P</var>
   = 2 ·  (
   <var>a</var>
   +
   <var>b</var>
   )  = 2 ·  ( 2
   <i>m</i>
   + 1
   <i>m</i>
   )  = 6
   <i>m</i>
  </span>
 </p>
 <p>
 </p>
</div>
