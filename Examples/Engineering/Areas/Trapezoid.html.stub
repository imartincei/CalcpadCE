<div class="calcpad-output">
 <!-- Area $A = \tfrac{1}{2}(a + b)\, h$ of a trapezoid from its two parallel sides and height. -->
 <h1>Area and Perimeter of Trapezoid</h1>
 <div style="max-width:90mm;">
  <img alt="trapezoid.png" class="side" src="Images/math/area/trapezoid.png" style="height:60pt;"/>
 </div>
 <p>Base lengths</p>
 <p>
  Bottom base -
  <span class="eq">
   <var>a</var>
   = 2
   <i>m</i>
  </span>
  , Top base -
  <span class="eq">
   <var>b</var>
   = 1
   <i>m</i>
  </span>
 </p>
 <p>
  Height -
  <span class="eq">
   <var>h</var>
   = 1
   <i>m</i>
  </span>
 </p>
 <p>Area</p>
 <p>
  <span class="eq">
   <var>A</var>
   =
   <span class="dvc">
    (
    <var>a</var>
    +
    <var>b</var>
    )  ·
    <var>h</var>
    <span class="dvl">
    </span>
    2
   </span>
   =
   <span class="dvc">
    ( 2
    <i>m</i>
    + 1
    <i>m</i>
    )  · 1
    <i>m</i>
    <span class="dvl">
    </span>
    2
   </span>
   = 1.5
   <i>m</i>
   <sup class="unit">2</sup>
  </span>
 </p>
 <p>Perimeter (symmetrical figure only)</p>
 <p>
  <span class="eq">
   <var>c</var>
   =
   <span class="o1">
    <span class="r1">
    </span>
    <var>h</var>
    <sup>2</sup>
    +
    <span class="dvc">
     (
     <var>a</var>
     −
     <var>b</var>
     )
     <sup>2</sup>
     <span class="dvl">
     </span>
     4
    </span>
   </span>
   =
   <span class="o1">
    <span class="r1">
    </span>
    1
    <i>m</i>
    <sup>2</sup>
    +
    <span class="dvc">
     ( 2
     <i>m</i>
     − 1
     <i>m</i>
     )
     <sup>2</sup>
     <span class="dvl">
     </span>
     4
    </span>
   </span>
   = 1.12
   <i>m</i>
  </span>
 </p>
 <p>
  <span class="eq">
   <var>P</var>
   =
   <var>a</var>
   +
   <var>b</var>
   + 2 ·
   <var>c</var>
   = 2
   <i>m</i>
   + 1
   <i>m</i>
   + 2 · 1.12
   <i>m</i>
   = 5.24
   <i>m</i>
  </span>
 </p>
 <p>
 </p>
</div>
