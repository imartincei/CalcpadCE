'<!-- Generate a fully parametric SVG cross-section of a prestressed double-tee panel by composing reusable `#def` shape templates from [`svg_drawing.cpd`](https://github.com/imartincei/CalcpadCE/blob/main/Examples/Engineering/3D%2C%20Plotting%2C%20Drawing/svg_drawing.cpd).
'Adjust any dimension and the drawing redraws itself — ideal for standardised structural detail libraries. -->
#include svg_drawing.cpd
'<h1>Prestressed TT Panel - Parametric SVG Generation</h1>
#deg
'Dimensions:
#UI 'Rib height -'h = 750mm
#UI 'Rib top width -'b_2 = 200mm
#UI 'Slab depth -'h_f = 100mm
#UI 'Rib spacing c/c -'B_0 = 1500mm
#UI 'Slab width -'B = 2500mm
#post
'Total height -'H = h + h_f
'Rib bottom width -'b_1 = b_2 - (h - 30mm)/10
'- mean -'b_w = (b_1 + b_2)/2
'- at <var>z</var> from top -'b(z) = b_2 - (b_2 - b_1)*z/h
'Rib effective width -'b_f = B/2
#end post
#UI 'Distance from the center of the first row of tendons to the bottom edge -'d_p1 = 80mm
#UI 'Number of tendons in one row -'n_ph = 2
#UI 'Number of rows -'n_pv = 3
#hide
x_1 = B_0/2
x_2 = x_1 + b_2/2
x_3 = x_2 + 140mm
x_4 = x_1 + b_1/2
x_5 = x_4 - b_1
x_6 = x_2 - b_2
x_7 = x_6 - 140mm
x_8 = x_1 - 20mm*(n_ph - 1)
#end hide
#post
#val
'<svg viewbox="'-b_f - 200mm' -150 'B + 300mm' 'H + 400mm'" xmlns="http://www.w3.org/2000/svg" version="1.1" style="font-family: Arial Nova Cond, Noto Sans Cond, Segoe UI; font-size: '54'px; width:500pt; height:'500*H/B + 50'pt">
'<polygon points="'b_f','0' 'b_f','h_f' 'x_3','h_f' 'x_2','h_f + 30mm' 'x_4','H' 'x_5','H' 'x_6','h_f + 30mm' 'x_7','h_f' '-x_7','h_f' '-x_6','h_f + 30mm' '-x_5','H' '-x_4','H' '-x_2','h_f + 30mm' '-x_3','h_f' '-b_f','h_f' '-b_f','0'" sec_style$/>
line$(-x_1; -100mm; -x_1; H + 100mm; axis_style$)
line$( x_1; -100mm; x_1; H + 100mm; axis_style$)
dimh$(-b_f; b_f; -60mm; B = 'B' mm)
dimv$(-b_f - 60mm; 0mm; H; H = 'H' mm)
dimv$(-b_f + 80mm; 0mm; h_f; h<tspan dy=20>f</tspan><tspan dy=-20> = </tspan>'h_f' mm         )
dimv$(-b_f + 80mm; h_f; H; <tspan dy=100>h = 'h' mm</tspan>)
dimh$(-x_1; x_1; H + 180mm; B<tspan dy=5>₀</tspan><tspan dy=-5> = 'B_0'</tspan> mm)
dimh$(-x_2; -x_6; h_f + 120mm;            b<tspan dy=5>₂</tspan><tspan dy=-5> = </tspan>'b_2' mm)
dimh$(-x_4; -x_5; H + 80mm;            b<tspan dy=5>₁</tspan><tspan dy=-5> = </tspan>'b_1' mm)
#hide
#def tendon$ = r="10" style="stroke:red; fill:red; stroke-width:1"
i = 0
#end hide
#repeat n_pv
	#hide
	j = 0
	#end hide
	#repeat n_ph
		'<circle cx="'x_8 + 40mm*j'" cy="'H - d_p1 - 40mm*i'" tendon$/>
		'<circle cx="'-x_8 - 40mm*j'" cy="'H - d_p1 - 40mm*i'" tendon$/>
		#hide
		j = j + 1
		#end hide
	#loop
	#hide
	i = i + 1
	#end hide
#loop
'</svg>
#end val
#end post
