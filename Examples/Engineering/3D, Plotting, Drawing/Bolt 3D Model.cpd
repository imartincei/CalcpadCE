'<!-- Embed a [glTF 3D model](https://en.wikipedia.org/wiki/GlTF) directly in a CalcpadCE worksheet using the Google [`<model-viewer>`](https://modelviewer.dev) web component.
'Combine the rotating CAD preview with parametric bolt resistance calculations to produce richly illustrated structural connection reports.
'
'Copy the code into the Desktop application to change the parameters in real-time. -->
#html
<script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.0.1/model-viewer.min.js"></script>
<model-viewer style="height:280pt;" class="side" src="./Models/bolt_and_nut.glb" alt="bolt_and_nut.glb" auto-rotate camera-controls shadow-intensity="0.5" field-of-view="8deg"></model-viewer>
#end html
'<h4>Loads (for one bolt)</h4>
#UI 'Tension -'F_t_Ed = 20kN
#UI 'Shear -'F_v_Ed = 10kN
'<h4>Bolt data</h4>
#UI {"type": "dropdown", "keys": ["M12", "M14", "M16", "M18", "M20", "M22", "M24", "M27", "M30", "M36"], "values": ["12", "14", "16", "18", "20", "22", "24", "27", "30", "36"]} 'Bolt diameter -'d = 12mm
#hide
#if d ≡ 12mm
	A_s = 84mm^2'  'd_0 = 13mm' 'd_m = 20.5mm
#else if d ≡ 14mm
	A_s = 115mm^2'  'd_0 = 15mm' 'd_m = 23.5mm
#else if d ≡ 16mm
	A_s = 157mm^2'  'd_0 = 18mm' 'd_m = 26mm
#else if d ≡ 18mm
	A_s = 192mm^2'  'd_0 = 20mm' 'd_m = 29mm
#else if d ≡ 20mm
	A_s = 245mm^2'  'd_0 = 22mm' 'd_m = 32mm
#else if d ≡ 22mm
	A_s = 303mm^2'  'd_0 = 24mm' 'd_m = 35.5mm
#else if d ≡ 24mm
	A_s = 353mm^2'  'd_0 = 26mm' 'd_m = 39mm
#else if d ≡ 27mm
	A_s = 459mm^2'  'd_0 = 30mm' 'd_m = 44mm
#else if d ≡ 30mm
	A_s = 561mm^2'  'd_0 = 33mm' 'd_m = 50mm
#else if d ≡ 36mm
	A_s = 817mm^2'  'd_0 = 39mm' 'd_m = 60mm
#end if
#end hide
#post
'Hole diameter -'d_0
'Punching diameter-'d_m
'Area of the unthreaded part (gross) -'A = π*d^2/4|mm^2
'Area of the threaded part (net) -'A_s
#end post
#UI {"type": "dropdown", "keys": ["4.6", "4.8", "5.6", "5.8", "6.8", "8.8", "10.9"], "values": ["4.6", "4.8", "5.6", "5.8", "6.8", "8.8", "10.9"]} 'Bolt steel grade -'Grade = 10.9
#hide
f_ub = floor(Grade)
f_yb = (Grade - f_ub)*f_ub*100MPa
f_ub = f_ub*100MPa
#end hide
#post
#val
'Bolt steel grade - 'Grade
#equ
'Bolt tensile strength -'f_ub
'Bolt yield strength -'f_yb
#end post
'<h4>Plate data</h4>
#UI 'Plate thickness - 't = 18mm
#UI {"type": "dropdown", "keys": ["235", "275", "355", "420", "460"], "values": ["235", "275", "355", "420", "460"]} 'Steel yield strength - 'f_y = 355MPa
#hide
#if f_y ≡ 235MPa
	f_u = 360MPa
#else if f_y ≡ 275MPa
	f_u = 430MPa
#else if f_y ≡ 355MPa
	f_u = 510MPa
#else if f_y ≡ 420MPa
	f_u = 520MPa
#else if f_y ≡ 460MPa
	f_u = 540MPa
#end if
#end hide
'Steel tensile strength - 'f_u
'Partial safety factors
γ_M0 = 1.05', 'γ_M2 = 1.25
