'<!-- Wires #UI drop-down, radio and checkbox controls into a worksheet to drive a parametric cross-section design. -->
#UI {"type": "dropdown", "keys": ["RHS 100x150", "RHS 150x200", "RHS 200x250"], "values": ["1", "2", "3"]} 'Cross section -'sec = 1
#hide
b_p = [100mm; 150mm; 200mm]
h_p = [150mm; 200mm; 250mm]
b = b_p.(sec)
h = h_p.(sec)
#end hide
'Dimensions:'b', 'h
#UI {"type": "radio", "keys": ["S235", "S275", "S355"], "values": ["235MPa", "275MPa", "355MPa"]} 'Steel grade -'f_y = 235MPa
'Steel yield strength:'f_y
'Additional options:
#UI {"type": "checkbox"} 'Hot rolled -'Rolled = 1
#UI {"type": "checkbox"} 'Zinc plated -'Zinc = 1
'Values:
Rolled
Zinc
