'<!-- Side-by-side plots of the [Archimedean](https://en.wikipedia.org/wiki/Archimedean_spiral), [logarithmic](https://en.wikipedia.org/wiki/Logarithmic_spiral), hyperbolic and Fermat spirals on the same canvas, parameterised in polar form $r(\theta)$. -->
#hide
#rad
r(θ) = 1
#end hide
'General parametric equation:
x(θ) = r(θ)*cos(θ)
y(θ) = r(θ)*sin(θ)
'The radius <i>r</i>(<i>θ</i>) if different for each type of curve:
'Archimedes spiral - 'r(θ) = θ
#hide
PlotWidth = 400
PlotHeight = 390
#end hide
#post
$Plot{x(θ)|y(θ) @ θ = 0 : 8*π}
#end post
'Fermat spiral - 'r(θ) = sqr(θ)
#hide
PlotHeight = 387
#end hide
#post
$Plot{x(θ)|y(θ) & -x(θ)|-y(θ) @ θ = 0 : 8*π}
#end post
#UI 'Growth rate -'a = 0.3
'Logarithmic spiral -'r(θ) = e^(a*θ)
#hide
φ = (1 + sqr(5))/2
PlotHeight = 259
#end hide
#post
$Plot{x(θ)|y(θ) @ θ = 0 : 8*π}
#end post
'Golden spiral -'r(θ) = φ^(2/π*θ)
#hide
PlotHeight = 255
#end hide
#post
$Plot{x(θ)|y(θ) @ θ = 0 : 8*π}
#end post
'Hyperbolic spiral -'r(θ) = 1/θ
#hide
PlotHeight = 177
#end hide
#post
$Plot{x(θ)|y(θ) @ θ = π/8 : 8*π}
#end post
'Lituus -'r(θ) = 1/sqr(θ)
#hide
PlotHeight = 188
#post
$Plot{x(θ)|y(θ) @ θ = π/16 : 16*π}
#end post
