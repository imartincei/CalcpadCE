<div class="calcpad-output">
 <!-- Volume and surface area of a right prism with a regular $n$-gon base, from side length and height. -->
 <div style="max-width:130mm">
  <img alt="polygonal-prism.png" class="side" src="Images/math/volume/polygonal-prism.png" style="height:65pt;"/>
 </div>
 <p>
  Number of sides -
  <span class="eq">
   <var>n</var>
   = 6
  </span>
 </p>
 <p>
  Side length -
  <span class="eq">
   <var>a</var>
   = 1
   <i>m</i>
  </span>
 </p>
 <p>
  Height -
  <span class="eq">
   <var>h</var>
   = 2
   <i>m</i>
  </span>
 </p>
 <!--
<-->
 <p>Area of base</p>
 <p>
  <span class="eq">
   <var>A</var>
   =
   <span class="dvc">
    <var>a</var>
    <sup>2</sup>
    ·
    <var>n</var>
    <span class="dvl">
    </span>
    4
   </span>
   ·
   <b>cot</b>
   <span class="b1">(</span>
   <span class="dvc">
    180°
    <span class="dvl">
    </span>
    <var>n</var>
   </span>
   <span class="b1">)</span>
   =
   <span class="dvc">
    1
    <i>m</i>
    <sup>2</sup>
    · 6
    <span class="dvl">
    </span>
    4
   </span>
   ·
   <b>cot</b>
   <span class="b1">(</span>
   <span class="dvc">
    180°
    <span class="dvl">
    </span>
    6
   </span>
   <span class="b1">)</span>
   = 2.6
   <i>m</i>
   <sup class="unit">2</sup>
  </span>
 </p>
 <p>Volume</p>
 <p>
  <span class="eq">
   <var>V</var>
   =
   <var>A</var>
   ·
   <var>h</var>
   = 2.6
   <i>m</i>
   <sup class="unit">2</sup>
   · 2
   <i>m</i>
   = 5.2
   <i>m</i>
   <sup class="unit">3</sup>
  </span>
 </p>
 <p>Surface area</p>
 <p>
  <span class="eq">
   <var>S</var>
   = 2 ·
   <var>A</var>
   +
   <var>n</var>
   ·
   <var>a</var>
   ·
   <var>h</var>
   = 2 · 2.6
   <i>m</i>
   <sup class="unit">2</sup>
   + 6 · 1
   <i>m</i>
   · 2
   <i>m</i>
   = 17.2
   <i>m</i>
   <sup class="unit">2</sup>
  </span>
 </p>
 <!--
<-->
</div>
