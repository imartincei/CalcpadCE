<div class="calcpad-output">
 <!-- Volume $V = a\, b\, c$ and surface area $S = 2(a b + b c + c a)$ of a rectangular prism (box). -->
 <div style="max-width:130mm">
  <img alt="rectangular-prism.png" class="side" src="Images/math/volume/rectangular-prism.png" style="height:65pt;"/>
 </div>
 <p>Dimensions of base</p>
 <p>
  Base length -
  <span class="eq">
   <var>a</var>
   = 3
   <i>m</i>
  </span>
  , Base width -
  <span class="eq">
   <var>b</var>
   = 2
   <i>m</i>
  </span>
 </p>
 <p>
  Height -
  <span class="eq">
   <var>h</var>
   = 1
   <i>m</i>
  </span>
 </p>
 <p>Volume</p>
 <p>
  <span class="eq">
   <var>V</var>
   =
   <var>a</var>
   ·
   <var>b</var>
   ·
   <var>h</var>
   = 3
   <i>m</i>
   · 2
   <i>m</i>
   · 1
   <i>m</i>
   = 6
   <i>m</i>
   <sup class="unit">3</sup>
  </span>
 </p>
 <p>Surface area</p>
 <p>
  <span class="eq">
   <var>S</var>
   = 2 ·  (
   <var>a</var>
   ·
   <var>b</var>
   +
   <var>b</var>
   ·
   <var>h</var>
   +
   <var>a</var>
   ·
   <var>h</var>
   )  = 2 ·  ( 3
   <i>m</i>
   · 2
   <i>m</i>
   + 2
   <i>m</i>
   · 1
   <i>m</i>
   + 3
   <i>m</i>
   · 1
   <i>m</i>
   )  = 22
   <i>m</i>
   <sup class="unit">2</sup>
  </span>
 </p>
 <p>
 </p>
</div>
