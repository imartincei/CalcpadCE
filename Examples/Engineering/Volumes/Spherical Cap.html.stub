<div class="calcpad-output">
 <!-- Volume and surface area of a spherical cap from sphere radius and cap height. -->
 <div style="max-width:120mm">
  <img alt="cap.png" class="side" src="Images/math/volume/cap.png" style="height:55pt;"/>
 </div>
 <p>
  Base radius -
  <span class="eq">
   <var>r</var>
   = 2
   <i>m</i>
  </span>
 </p>
 <p>
  Height -
  <span class="eq">
   <var>h</var>
   = 1
   <i>m</i>
  </span>
 </p>
 <p>Radius of sphere</p>
 <p>
  <span class="eq">
   <var>R</var>
   =
   <span class="dvc">
    <var>r</var>
    <sup>2</sup>
    +
    <var>h</var>
    <sup>2</sup>
    <span class="dvl">
    </span>
    2 ·
    <var>h</var>
   </span>
   =
   <span class="dvc">
    ( 2
    <i>m</i>
    )
    <sup>2</sup>
    + 1
    <i>m</i>
    <sup>2</sup>
    <span class="dvl">
    </span>
    2 · 1
    <i>m</i>
   </span>
   = 2.5
   <i>m</i>
  </span>
 </p>
 <p>Volume</p>
 <p>
  <span class="eq">
   <var>V</var>
   =
   <span class="dvc">
    <var>π</var>
    ·
    <var>h</var>
    <span class="dvl">
    </span>
    6
   </span>
   ·  ( 3 ·
   <var>r</var>
   <sup>2</sup>
   +
   <var>h</var>
   <sup>2</sup>
   )  =
   <span class="dvc">
    3.14 · 1
    <i>m</i>
    <span class="dvl">
    </span>
    6
   </span>
   ·  ( 3 ·  ( 2
   <i>m</i>
   )
   <sup>2</sup>
   + 1
   <i>m</i>
   <sup>2</sup>
   )  = 6.81
   <i>m</i>
   <sup class="unit">3</sup>
  </span>
 </p>
 <p>Area of curved surface</p>
 <p>
  <span class="eq">
   <var>S</var>
   <sub>o</sub>
   = 2 ·
   <var>π</var>
   ·
   <var>R</var>
   ·
   <var>h</var>
   = 2 · 3.14 · 2.5
   <i>m</i>
   · 1
   <i>m</i>
   = 15.71
   <i>m</i>
   <sup class="unit">2</sup>
  </span>
 </p>
 <p>Area of base</p>
 <p>
  <span class="eq">
   <var>A</var>
   =
   <var>π</var>
   ·
   <var>r</var>
   <sup>2</sup>
   = 3.14 ·  ( 2
   <i>m</i>
   )
   <sup>2</sup>
   = 12.57
   <i>m</i>
   <sup class="unit">2</sup>
  </span>
 </p>
 <p>Total surface area</p>
 <p>
  <span class="eq">
   <var>S</var>
   =
   <var>S</var>
   <sub>o</sub>
   +
   <var>A</var>
   = 15.71
   <i>m</i>
   <sup class="unit">2</sup>
   + 12.57
   <i>m</i>
   <sup class="unit">2</sup>
   = 28.27
   <i>m</i>
   <sup class="unit">2</sup>
  </span>
 </p>
 <p>
 </p>
</div>
