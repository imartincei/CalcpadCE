 </div>
 <p>Dimensions of base</p>
 <p>
  Base length -
  <span class="eq">
   <var>a</var>
   = 3
   <i>m</i>
  </span>
  , Base width -
  <span class="eq">
   <var>b</var>
   = 2
   <i>m</i>
  </span>
 </p>
 <p>
  Height -
  <span class="eq">
   <var>h</var>
   = 1
   <i>m</i>
  </span>
 </p>
 <p>Volume</p>
 <p>
  <span class="eq">
   <var>V</var>
   =
   <span class="dvc">
    1
    <span class="dvl">
    </span>
    3
   </span>
   ·
   <var>a</var>
   ·
   <var>b</var>
   ·
   <var>h</var>
   =
   <span class="dvc">
    1
    <span class="dvl">
    </span>
    3
   </span>
   · 3
   <i>m</i>
   · 2
   <i>m</i>
   · 1
   <i>m</i>
   = 2
   <i>m</i>
   <sup class="unit">3</sup>
  </span>
 </p>
 <p>Area of side faces</p>
 <p>
  <span class="eq">
   <var>S</var>
   <sub>o</sub>
   =
   <var>a</var>
   ·
   <span class="o1">
    <span class="r1">
    </span>
    <var>h</var>
    <sup>2</sup>
    +
    <span class="dvc">
     <var>b</var>
     <sup>2</sup>
     <span class="dvl">
     </span>
     4
    </span>
   </span>
   +
   <var>b</var>
   ·
   <span class="o1">
    <span class="r1">
    </span>
    <var>h</var>
    <sup>2</sup>
    +
    <span class="dvc">
     <var>a</var>
     <sup>2</sup>
     <span class="dvl">
     </span>
     4
    </span>
   </span>
   = 3
   <i>m</i>
   ·
   <span class="o1">
    <span class="r1">
    </span>
    1
    <i>m</i>
    <sup>2</sup>
    +
    <span class="dvc">
     ( 2
     <i>m</i>
     )
     <sup>2</sup>
     <span class="dvl">
     </span>
     4
    </span>
   </span>
   + 2
   <i>m</i>
   ·
   <span class="o1">
    <span class="r1">
    </span>
    1
    <i>m</i>
    <sup>2</sup>
    +
    <span class="dvc">
     ( 3
     <i>m</i>
     )
     <sup>2</sup>
     <span class="dvl">
     </span>
     4
    </span>
   </span>
   = 7.85
   <i>m</i>
   <sup class="unit">2</sup>
  </span>
