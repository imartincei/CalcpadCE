<div class="calcpad-output">
 <!-- Volume $V = \tfrac{4}{3}\pi r^3$ and surface area $S = 4\pi r^2$ of a sphere from its radius. -->
 <div style="max-width:100mm">
  <img alt="sphere.png" class="side" src="Images/math/volume/sphere.png" style="height:60pt;"/>
 </div>
 <p>
  Radius -
  <span class="eq">
   <var>r</var>
   = 1
   <i>m</i>
  </span>
 </p>
 <p>Volume</p>
 <p>
  <span class="eq">
   <var>V</var>
   =
   <span class="dvc">
    4
    <span class="dvl">
    </span>
    3
   </span>
   ·
   <var>π</var>
   ·
   <var>r</var>
   <sup>3</sup>
   =
   <span class="dvc">
    4
    <span class="dvl">
    </span>
    3
   </span>
   · 3.14 · 1
   <i>m</i>
   <sup>3</sup>
   = 4.19
   <i>m</i>
   <sup class="unit">3</sup>
  </span>
 </p>
 <p>Surface area</p>
 <p>
  <span class="eq">
   <var>S</var>
   = 4 ·
   <var>π</var>
   ·
   <var>r</var>
   <sup>2</sup>
   = 4 · 3.14 · 1
   <i>m</i>
   <sup>2</sup>
   = 12.57
   <i>m</i>
   <sup class="unit">2</sup>
  </span>
 </p>
 <p>
