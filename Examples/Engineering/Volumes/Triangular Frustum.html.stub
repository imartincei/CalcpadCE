<div class="calcpad-output">
 <!-- Volume of a triangular frustum from the two parallel triangular faces and height. -->
 <div style="max-width:120mm">
  <img alt="triangular-frustum.png" class="side" src="Images/math/volume/triangular-frustum.png" style="height:60pt;"/>
 </div>
 <p>
  <b>Dimensions:</b>
 </p>
 <p>
  Bottom side -
  <span class="eq">
   <var>A</var>
   = 10
   <i>m</i>
  </span>
  , Bottom side -
  <span class="eq">
   <var>B</var>
   = 8
   <i>m</i>
  </span>
  , Bottom side -
  <span class="eq">
   <var>C</var>
   = 6
   <i>m</i>
  </span>
 </p>
 <p>
  Top side -
  <span class="eq">
   <var>a</var>
   = 5
   <i>m</i>
  </span>
 </p>
 <p>
  <span class="eq">
   <var>b</var>
   =
   <span class="dvc">
    <var>B</var>
    ·
    <var>a</var>
    <span class="dvl">
    </span>
    <var>A</var>
   </span>
   =
   <span class="dvc">
    8
    <i>m</i>
    · 5
    <i>m</i>
    <span class="dvl">
    </span>
    10
    <i>m</i>
   </span>
   = 4
   <i>m</i>
  </span>
 </p>
 <p>
  <span class="eq">
   <var>c</var>
   =
   <span class="dvc">
    <var>C</var>
    ·
    <var>a</var>
    <span class="dvl">
    </span>
    <var>A</var>
   </span>
   =
   <span class="dvc">
    6
    <i>m</i>
    · 5
    <i>m</i>
    <span class="dvl">
    </span>
    10
    <i>m</i>
   </span>
   = 3
   <i>m</i>
  </span>
 </p>
 <p>
  Height -
  <span class="eq">
   <var>h</var>
   = 2
   <i>m</i>
  </span>
 </p>
 <!--
<-->
 <p>
  <b>Bottom base</b>
 </p>
 <p>Semiperimeter</p>
 <p>
  <span class="eq">
   <var>p</var>
   = 0.5 ·  (
   <var>A</var>
   +
   <var>B</var>
   +
   <var>C</var>
   )  = 0.5 ·  ( 10
   <i>m</i>
   + 8
   <i>m</i>
   + 6
   <i>m</i>
   )  = 12
   <i>m</i>
  </span>
 </p>
 <p>Area (Heron equation)</p>
 <p>
  <span class="eq">
   <var>A</var>
   <sub>1</sub>
   =
   <span class="o0">
    <span class="r">√</span>
    <var>p</var>
    ·  (
    <var>p</var>
    −
    <var>A</var>
    )  ·  (
    <var>p</var>
    −
    <var>B</var>
    )  ·  (
    <var>p</var>
    −
    <var>C</var>
    )
   </span>
   =
   <span class="o0">
    <span class="r">√</span>
    12
    <i>m</i>
    ·  ( 12
    <i>m</i>
    − 10
    <i>m</i>
    )  ·  ( 12
    <i>m</i>
    − 8
    <i>m</i>
    )  ·  ( 12
    <i>m</i>
    − 6
    <i>m</i>
    )
   </span>
   = 24
   <i>m</i>
   <sup class="unit">2</sup>
  </span>
 </p>
 <p>
  <b>Top base</b>
 </p>
 <p>Semiperimeter</p>
 <p>
  <span class="eq">
   <var>p</var>
   = 0.5 ·  (
   <var>a</var>
   +
   <var>b</var>
   +
   <var>c</var>
   )  = 0.5 ·  ( 5
   <i>m</i>
   + 4
   <i>m</i>
   + 3
   <i>m</i>
   )  = 6
   <i>m</i>
  </span>
 </p>
 <p>Area (Heron equation)</p>
 <p>
  <span class="eq">
   <var>A</var>
   <sub>2</sub>
   =
   <span class="o0">
    <span class="r">√</span>
    <var>p</var>
    ·  (
    <var>p</var>
    −
    <var>a</var>
    )  ·  (
    <var>p</var>
    −
    <var>b</var>
    )  ·  (
    <var>p</var>
    −
    <var>c</var>
    )
   </span>
   =
   <span class="o0">
    <span class="r">√</span>
    6
    <i>m</i>
    ·  ( 6
    <i>m</i>
    − 5
    <i>m</i>
    )  ·  ( 6
    <i>m</i>
    − 4
    <i>m</i>
    )  ·  ( 6
    <i>m</i>
    − 3
    <i>m</i>
    )
   </span>
   = 6
   <i>m</i>
   <sup class="unit">2</sup>
  </span>
 </p>
 <p>
  <b>Volume</b>
 </p>
 <p>
  <span class="eq">
   <var>V</var>
   =
   <span class="dvc">
    <var>h</var>
    <span class="dvl">
    </span>
    3
   </span>
   ·  (
   <var>A</var>
   <sub>1</sub>
   +
   <span class="o0">
    <span class="r">√</span>
    <var>A</var>
    <sub>1</sub>
    ·
    <var>A</var>
    <sub>2</sub>
   </span>
   +
   <var>A</var>
   <sub>2</sub>
   )  =
   <span class="dvc">
    2
    <i>m</i>
    <span class="dvl">
    </span>
    3
   </span>
   ·  ( 24
   <i>m</i>
   <sup class="unit">2</sup>
   +
   <span class="o0">
    <span class="r">√</span>
    24
    <i>m</i>
    <sup class="unit">2</sup>
    · 6
    <i>m</i>
    <sup class="unit">2</sup>
   </span>
   + 6
   <i>m</i>
   <sup class="unit">2</sup>
   )  = 28
   <i>m</i>
   <sup class="unit">3</sup>
  </span>
 </p>
 <!--
<-->
</div>
