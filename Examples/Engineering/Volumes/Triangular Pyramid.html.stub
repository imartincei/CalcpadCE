<div class="calcpad-output">
 <!-- Volume $V = \tfrac{1}{3} A_b\, h$ of a pyramid with a general triangular base. -->
 <div style="max-width:110mm">
  <img alt="triangular-pyramid.png" class="side" src="Images/math/volume/triangular-pyramid.png" style="height:60pt;"/>
 </div>
 <p>Dimensions of base</p>
 <p>
  Side a -
  <span class="eq">
   <var>a</var>
   = 5
   <i>m</i>
  </span>
  , Side b -
  <span class="eq">
   <var>b</var>
   = 4
   <i>m</i>
  </span>
  , Side c -
  <span class="eq">
   <var>c</var>
   = 3
   <i>m</i>
  </span>
 </p>
 <p>
  Height -
  <span class="eq">
   <var>h</var>
   = 2
   <i>m</i>
  </span>
 </p>
 <!--
<-->
 <p>Semiperimeter of base</p>
 <p>
  <span class="eq">
   <var>p</var>
   = 0.5 ·  (
   <var>a</var>
   +
   <var>b</var>
   +
   <var>c</var>
   )  = 0.5 ·  ( 5
   <i>m</i>
   + 4
   <i>m</i>
   + 3
   <i>m</i>
   )  = 6
   <i>m</i>
  </span>
 </p>
 <p>Area of base (Heron equation)</p>
 <p>
  <span class="eq">
   <var>A</var>
   =
   <span class="o0">
    <span class="r">√</span>
    <var>p</var>
    ·  (
    <var>p</var>
    −
    <var>a</var>
    )  ·  (
    <var>p</var>
    −
    <var>b</var>
    )  ·  (
    <var>p</var>
    −
    <var>c</var>
    )
   </span>
   =
   <span class="o0">
    <span class="r">√</span>
    6
    <i>m</i>
    ·  ( 6
    <i>m</i>
    − 5
    <i>m</i>
    )  ·  ( 6
    <i>m</i>
    − 4
    <i>m</i>
    )  ·  ( 6
    <i>m</i>
    − 3
    <i>m</i>
    )
   </span>
   = 6
   <i>m</i>
   <sup class="unit">2</sup>
  </span>
 </p>
 <p>Volume</p>
 <p>
  <span class="eq">
   <var>V</var>
   =
   <span class="dvc">
    1
    <span class="dvl">
    </span>
    3
   </span>
   ·
   <var>A</var>
   ·
   <var>h</var>
   =
   <span class="dvc">
    1
    <span class="dvl">
    </span>
    3
   </span>
   · 6
   <i>m</i>
   <sup class="unit">2</sup>
   · 2
   <i>m</i>
   = 4
   <i>m</i>
   <sup class="unit">3</sup>
  </span>
 </p>
 <!--
<-->
</div>
