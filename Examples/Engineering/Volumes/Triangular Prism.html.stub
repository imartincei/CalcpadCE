<div class="calcpad-output">
 <!-- Volume and surface area of a right triangular prism, from triangle sides and prism length. -->
 <div style="max-width:120mm">
  <img alt="triangular-prism.png" class="side" src="Images/math/volume/triangular-prism.png" style="height:60pt;"/>
 </div>
 <p>Dimensions of base</p>
 <p>
  Side a -
  <span class="eq">
   <var>a</var>
   = 5
   <i>m</i>
  </span>
  , Side b -
  <span class="eq">
   <var>b</var>
   = 4
   <i>m</i>
  </span>
  , Side c -
  <span class="eq">
   <var>c</var>
   = 3
   <i>m</i>
  </span>
 </p>
 <p>
  Height -
  <span class="eq">
   <var>h</var>
   = 2
   <i>m</i>
  </span>
 </p>
 <!--
<-->
 <p>Base perimeter</p>
 <p>
  <span class="eq">
   <var>P</var>
   =
   <var>a</var>
   +
   <var>b</var>
   +
   <var>c</var>
   = 5
   <i>m</i>
   + 4
   <i>m</i>
   + 3
   <i>m</i>
   = 12
   <i>m</i>
  </span>
 </p>
 <p>Semiperimeter</p>
 <p>
  <span class="eq">
   <var>p</var>
   = 0.5 ·
   <var>P</var>
   = 0.5 · 12
   <i>m</i>
   = 6
   <i>m</i>
  </span>
 </p>
 <p>Area of base (Heron equation)</p>
 <p>
  <span class="eq">
   <var>A</var>
   =
   <span class="o0">
    <span class="r">√</span>
    <var>p</var>
    ·  (
    <var>p</var>
    −
    <var>a</var>
    )  ·  (
    <var>p</var>
    −
    <var>b</var>
    )  ·  (
    <var>p</var>
    −
    <var>c</var>
    )
   </span>
   =
   <span class="o0">
    <span class="r">√</span>
    6
    <i>m</i>
    ·  ( 6
    <i>m</i>
    − 5
    <i>m</i>
    )  ·  ( 6
    <i>m</i>
    − 4
    <i>m</i>
    )  ·  ( 6
    <i>m</i>
    − 3
    <i>m</i>
    )
   </span>
   = 6
   <i>m</i>
   <sup class="unit">2</sup>
  </span>
 </p>
 <p>Volume</p>
 <p>
  <span class="eq">
   <var>V</var>
   =
   <var>A</var>
   ·
   <var>h</var>
   = 6
   <i>m</i>
   <sup class="unit">2</sup>
   · 2
   <i>m</i>
   = 12
   <i>m</i>
   <sup class="unit">3</sup>
  </span>
 </p>
 <p>Surface area</p>
 <p>
  <span class="eq">
   <var>S</var>
   = 2 ·
   <var>A</var>
   +
   <var>h</var>
   ·
   <var>P</var>
   = 2 · 6
   <i>m</i>
   <sup class="unit">2</sup>
   + 2
   <i>m</i>
   · 12
   <i>m</i>
   = 36
   <i>m</i>
   <sup class="unit">2</sup>
  </span>
 </p>
 <!--
<-->
</div>
