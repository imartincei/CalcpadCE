'<!-- Trapezoidal load between intensities $q_1$ and $q_2$, with the support moments split as $(3 q_1 + 2 q_2) l^2 / 60$ and $(2 q_1 + 3 q_2) l^2 / 60$. -->
'<div style="max-width:180mm;">
'<img style="width:210pt;" alt="fixed-beam-distributed-load-linear.png" class="side" src="../../Images/mechanics/beams/fixed-beam-distributed-load-linear.png">
'<p><b>Input data</b></p>
#UI 'Beam Length -'l = 10m
#UI 'Load -'q_1 = 5kN/m','q_2 = 10kN/m
Δq = q_2 - q_1|kN/m
#post
'<p><b>Internal forces</b></p>
'Bending at supports
M_A = (3*q_1 + 2*q_2)*l^2/60|kNm
M_B = (2*q_1 + 3*q_2)*l^2/60|kNm
'Shear
V_A = l/20*(7*q_1 + 3*q_2)|kN
V_B = l/20*(3*q_1 + 7*q_2)|kN
'Bending at mid-span
#if '<!--'Δq ≡ 0kN/m'-->
	x_max = l/2
#else
	x_max = l*(sqr(q_1^2 + 2*V_A*Δq/l) - q_1)/Δq
#end if
M_max = V_A*x_max - (3*l*q_1 + Δq*x_max)*x_max^2/(6*l) - M_A|kNm
'<p><b>Diagrams</b></p>
#hide
PlotWidth = 600
PlotHeight = 150
#end hide
#UI 'Calculate internal forces at'x_1 = 1m
#pre


#post
q(x) = q_1 + Δq*x/l
'Bending
M(x) = -M_A + V_A*x - (2*q_1 + q(x))*x^2/6
$Plot{-M(x) @ x = 0m : l}
M(x_1)|kNm
'Shear
V(x) = V_A - (q_1 + q(x))*x/2
$Plot{V(x) @ x = 0m : l}
V(x_1)|kN
#end post
'</div>
