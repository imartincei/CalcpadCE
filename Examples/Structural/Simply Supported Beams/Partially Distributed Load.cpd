'<!-- Uniform load $q$ acting on a stretch of length $b$ between offsets $a$ and $c = l - a - b$, with a guard against an invalid load length when $a + b > l$. -->
'<div style = "max-width:180mm;">
'<img style="width:190pt;" alt = "simply-supported-beam-distributed-load-partial.png" class="side" src = "../../Images/mechanics/beams/simply-supported-beam-distributed-load-partial.png">
'<p><b>Input data</b></p>
#UI 'Beam length -'l = 5m
#UI 'Load -'q = 10kN/m
#UI 'Distances -'a = 1m','b = 2m
#post
c = l - (a + b)
#if '<!--'c < 0m'-->
	'<p class="err">Invalid load length</p>
#else
	'<p><b>Internal forces</b></p>
	'Distance -'x_max = a + b*(b/2 + c)/l
	'Bending
	M_max = q*(x_max^2 - a^2)/2|kNm
	'Shear
	V_A = q*b*(b/2 + c)/l|kN
	V_B = -q*b*(b/2 + a)/l|kN
	'<p><b>Diagrams</b></p>
	#hide
	PlotWidth = 600
	PlotHeight = 150
	#end hide
	#end post
	#UI 'Calculate internal forces at'x_1 = 1.5m
	#post
	'Bending
	M(x) = V_A*x - q*(x - a)^2/2*(x > a) + q*(x - a - b)^2/2*(x > a + b)
	$Plot{-M(x) @ x = 0m : l}
	M(x_1)|kNm
	'Shear
	V(x) = V_A - q*(x - a)*(x > a) + q*(x - a - b)*(x > a + b)
	$Plot{V(x) @ x = 0m : l}
	V(x_1)|kN
#end if
#end post
'</div>
