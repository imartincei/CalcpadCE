'<!-- Full-span uniform load $q$, recovering the textbook results $M_{max} = q l^2 / 8$ and $V_{max} = q l / 2$. -->
'<div style = "max-width:180mm;">
'<img style="width:190pt;" alt = simply-supported-beam-distributed-load-uniform.png" class="side" src = "../../Images/mechanics/beams/simply-supported-beam-distributed-load-uniform.png">
'<p><b>Input data</b></p>
#UI 'Beam length -'l = 5m
#UI 'Load -'q = 10kN/m
#post
'<p><b>Internal forces</b></p>
'Bending -'M_max = q*l^2/8|kNm
'Shear -'V_max = q*l/2|kN
'<p><b>Diagrams</b></p>
#hide
PlotWidth = 600
PlotHeight = 150
#end hide
#end post
#UI 'Calculate internal forces at'x_1 = 1m
#post
'Bending
M(x) = q*x*(l - x)/2
$Plot{-M(x) @ x = 0m : l}
M(x_1)|kNm
'Shear
V(x) = q*(l/2 - x)
$Plot{V(x) @ x = 0m : l}
V(x_1)|kN
#end post
'</div>
