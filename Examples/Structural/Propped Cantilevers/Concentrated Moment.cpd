'<!-- Propped cantilever loaded by a concentrated moment $M$ at distance $a$, giving a constant shear and a bending diagram with a jump of $M$ across the load section. -->
'<div style="max-width:180mm;">
'<img style="width:210pt;" alt="propped-cantilever-beam-concentrated-moment.png" class="side" src="../../Images/mechanics/beams/propped-cantilever-beam-concentrated-moment.png">
'<p><b>Input data</b></p>
#UI 'Beam Length -'l = 10m
#UI 'Load -'M = 10kNm
#UI 'Distances -'a = 6m
#post
b = l - a','k = b/l
'<p><b>Internal forces</b></p>
'Bending at support
M_A = M*(1 - 3*k^2)/2|kNm
'Shear
V = 3*M*(1 - k^2)/(2*l)|kN
'Bending at mid-span
M_a = V*a - M_A|kNm
M_b = V*b|kNm
'<p><b>Diagrams</b></p>
#hide
PlotWidth = 600
PlotHeight = 150
#end hide
#end post
#UI 'Calculate internal forces at'x_1 = 1m
#post
'Bending
M(x) = M_A - V*x + M*(x > a)
$Plot{-M(x) @ x = 0m : l}
M(x_1)|kNm
'Shear
V(x) = -V
$Plot{V(x) @ x = 0m : l}
V(x_1)|kN
#end post
'</div>
