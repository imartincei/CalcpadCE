'<!-- Punching shear verification of a flat slab around an internal column: closed control perimeter, slab strength without and with shear reinforcement, and required area of stirrups, studs or bent-up bars. -->
'<small>According to <strong>Eurocode</strong>: EN 1992-1-1</small>
'<div style="max-width:180mm">
'<img class="side" style="width:260pt;" src="../../Images/structures/rc/design/punching.png" alt="punching.png">
'<h4>Input data</h4>
'<p><b>Column</b></p>
#UI 'Dimensions - 'c_1 = 600mm', 'c_2 = 300mm
'<p><b>Design loads</b></p>
#UI 'Support reaction -'V_Ed = 500kN
'Bending moments
#UI 'About x -'M_x_Ed = 0kNm', about y -'M_y_Ed = 0kNm
'<p><b>Slab</b></p>
#UI 'Depth -'h = 200mm
#UI 'Concrete cover -'c = 20mm
#UI {"type": "dropdown", "keys": ["Ø6", "Ø8", "Ø10", "Ø12", "Ø14", "Ø16", "Ø18", "Ø20", "Ø22", "Ø25", "Ø28", "Ø32"], "values": ["6mm", "8mm", "10mm", "12mm", "14mm", "16mm", "18mm", "20mm", "22mm", "25mm", "28mm", "32mm"]} 'Longitudinal bars diameter -'d_bL = 10mm
#UI {"type": "dropdown", "keys": ["Ø6", "Ø8", "Ø10", "Ø12", "Ø14", "Ø16"], "values": ["6mm", "8mm", "10mm", "12mm", "14mm", "16mm"]} 'Links diameter -'d_w = 6mm
#post
'Effective slab depth
d = h - c - d_bL|mm
#end post
'Longitudinal reinforcement area
#UI 'Along x -'A_sx = 1200mm^2/m', along y -'A_sy = 1200mm^2/m
#post
'Reinforcement ratio
ρ_lx = A_sx/d
ρ_ly = A_sy/d
ρ_l = sqr(ρ_lx*ρ_ly)
#end post
'<p><b>Material properties</b></p>
'<p><b>Concrete</b> [EN 1992-1-1, Table 3.1]</p>
#UI 'Characteristic compressive cylinder strength -'f_ck = 25MPa
'Partial safety factor for concrete -'γ_c = 1.5
#UI 'Coefficient for long-term effects -'α_cc = 1
#post
'Design compressive cylinder strength -'f_cd = α_cc*f_ck/γ_c|MPa
#end post
'<p><b>Steel</b></p>
#UI 'Characteristic yield strength -'f_yk = 500MPa
#post
'Partial safety factor for steel -'γ_s = 1.15
'Design yield strength -'f_ywd = f_yk/γ_s|MPa
'Basic control perimeter length
u_1 = 2*(c_1 + c_2) + 4*π*d|mm
'<p><b>Calculation of the β factor</b></p>
#if M_y_Ed ≡ 0kNm
	#if M_x_Ed ≡ 0kNm
		'<p class="ref">[EN 1992-1-1, Figure 6.21N]</p>
		β = 1.15
	#else
		'<p class="ref">[EN 1992-1-1 (6.41)]</p>
		'Critical perimeter modulus
		W_1 = c_1^2/2 + c_1*c_2 + 4*c_2*d + 16*d^2 + 2*π*d*c_1|mm^2
		k_c = c_1/c_2
		'<p class="ref">[EN 1992-1-1, Table 6.1]</p>
		#if k_c ≤ 0.5
			k = 0.45
		#else if k_c < 1
			k = 0.45 + (k_c - 0.5)*0.15
		#else if k_c < 2
			k = 0.6 + (k_c - 1)*0.1
		#else if k_c < 3
			k = 0.7 + (k_c - 2)*0.1
		#else
			k = 0.8
		#end if
		'<p class="ref">[EN 1992-1-1 (6.39)]</p>
		β = 1 + k*M_x_Ed/V_Ed*u_1/W_1
	#end if
#else
	#if M_x_Ed ≡ 0kNm
		'<p class="ref">[EN 1992-1-1 (6.41)]</p>
		'Critical perimeter modulus
		W_1 = c_2^2/2 + c_1*c_2 + 4*c_1*d + 16*d^2 + 2*π*d*c_2|mm^2
		k_c = c_2/c_1
		'<p class="ref">[EN 1992-1-1, Table 6.1]</p>
		#if k_c ≤ 0.5
			k = 0.45
		#else if k_c < 1
			k = 0.45 + (k_c - 0.5)*0.15
		#else if k_c < 2
			k = 0.6 + (k_c - 1)*0.1
		#else if k_c < 3
			k = 0.7 + (k_c - 2)*0.1
		#else
			k = 0.8
		#end if
		'<p class="ref">[EN 1992-1-1 (6.39)]</p>
		β = 1 + k*M_y_Ed/V_Ed*u_1/W_1
	#else
		e_x = M_x_Ed/V_Ed|mm
		e_y = M_y_Ed/V_Ed|mm
		b_x = c_1 + 4*d|mm
		b_y = c_2 + 4*d|mm
		'<p class="ref">[EN 1992-1-1 (6.43)]</p>
		β = 1 + 1.8*sqr((e_x/b_x)^2 + (e_y/b_y)^2)
	#end if
#end if
#if β < 1.15
	'<p class="ref">[EN 1992-1-1, Figure 6.21N]</p>
	β'&lt; 1.15. The relevant value is assumed:'β = 1.15
#end if
'<div class="fold">
'<h4>Punching shear resistance without reinforcement</h4>
k = min(1 + sqr(200mm/d);2)
C_Rd_c = 0.18/γ_c
'<p class="ref">[EN 1992-1-1 (6.47)]</p>
'Punching shear resistance
v_Rd_c_ = C_Rd_c*k*(100*ρ_l*f_ck/1MPa)^(1/3)*1MPa|MPa
'<p class="ref">[EN 1992-1-1 (6.2b)]</p>
'Minimum shear resistance
v_min = 0.035*k^(3/2)*sqr(f_ck/1MPa)*1MPa|MPa
v_Rd_c = max(v_Rd_c_; v_min)|MPa
'<p class="ref">[EN 1992-1-1 (6.38)]</p>
'Design shear stress
v_Ed = β*V_Ed/(u_1*d)|MPa
'</div>
'<p class="ref">[EN 1992-1-1, §6.4.3 (2,b)]</p>
#if v_Ed ≤ v_Rd_c
	v_Ed' &le; 'v_Rd_c'. Shear reinforcement is NOT required.
#else
	v_Ed' &gt;'v_Rd_c'. Shear reinforcement is required.
	'<div class="fold">
	'<h4>Check at column edge</h4>
	'Column perimeter
	u_0 = 2*(c_1 + c_2)|mm
	'<p class="ref">[EN 1992-1-1 (6.53)]</p>
	'Punching shear resistance at column edge
	v_Ed_max = β*V_Ed/(u_0*d)|MPa
	'Maximum punching shear stress
	ν = 0.6*(1 - f_ck/250MPa)
	'<p class="ref">[BS EN 1992-1-1, Table NA.1, §6.4.5 (3)]</p>
	v_Rd_max = 0.5*ν*f_cd|MPa
	'</div>
	'<p class="ref">[EN 1992-1-1, §6.4.3 (2,a)]</p>
	#if v_Ed_max ≤ v_Rd_max
		v_Ed_max' &le; 'v_Rd_max'. Design check is satisfied.
	#else
		'<p class="err">'v_Ed_max' &gt; 'v_Rd_max'. Design check is NOT satisfied!</p>
		'<p class="err">Increase slab thickness, column dimensions or concrete grade.</p>
	#end if
	'<p class="ref">[BS EN 1992-1-1, Table NA.1, §6.4.5 (3)]</p>
	'Limitation of punching stress at first control perimeter
	#if v_Ed ≤ 2*v_Rd_c
		v_Ed' &le; '2*v_Rd_c'. Design check is satisfied.
	#else
		'<p class="err">'v_Ed' &gt; '2*v_Rd_c'. Design check is NOT satisfied!</p>
	#end if
	'<div class="fold">
	'<h4>Punching resistance with shear reinforcement</h4>
	'Effective yield strength of shear reinforcement
	f_ywd_ef = min(250MPa + 0.25MPa*d/1mm;f_ywd)|MPa
	'Area of one shear link
	A_sw_1 = π*d_w^2/4|mm^2
	'<p class="ref">[EN 1992-1-1, §9.4.3 (1)]</p>
	'Radial link spacing - 's_r = 0.75*d|mm
	'Required shear reinforcement
	A_sw_req = (v_Ed - 0.75*v_Rd_c)*u_1*s_r/(1.5*f_ywd_ef)|mm^2
	'Tangential link spacing - 's_t = floor(u_1*A_sw_1/A_sw_req/1mm)*1mm|mm
	'<p class="ref">[EN 1992-1-1, §9.4.3 (1)]</p>
	#if s_t ≤ 1.5*d
		'Check:'s_t' &le; '1.5*d'. Check is satisfied.
	#else
		'Check:'s_t' &gt;'1.5*d'.
		'<p class="err">Distance exceeds the maximum value.</p>
		'Accepted value: 's_t = 1.5*d|mm
	#end if
	'<p class="ref">[EN 1992-1-1, §9.4.3 (2)]</p>
	'Minimum shear reinforcement
	A_sw_min = 0.08*sqr(f_ck/1MPa)*1MPa/f_yk*s_r*s_t/1.5|mm^2
	#if A_sw_1 ≥ A_sw_min
		A_sw_1' &ge;'A_sw_min'. The calculated reinforcement is greater than the minimum.
	#else
		'<p class="err">'A_sw_1' &lt;'A_sw_min'. The calculated reinforcement is lower than the minimum!</p>
	#end if
	'</div>
	'Total shear reinforcement for each perimeter
	A_sw = A_sw_1*u_1/s_t|mm^2
	'<p class="ref">[EN 1992-1-1 (6.52)]</p>
	'Punching resistance with shear reinforcement
	v_Rd_cs = 0.75*v_Rd_c + 1.5*d/s_r*A_sw*f_ywd_ef/(u_1*d)|MPa
	#if v_Ed ≤ v_Rd_cs
		v_Ed' &le;'v_Rd_cs'. Check is satisfied!
		'<p class="ref">[EN 1992-1-1 (6.54)]</p>
		'Outer control perimeter at which shear reinforcement is not required
		u_out = β*V_Ed/(v_Rd_c*d)|mm
		'Distance to outer control perimeter
		a_out = (u_out/2 - c_1 - c_2)/π|mm
		'Required number of perimeters
		n = ceiling(max((a_out - 2*d)/(0.75*d) + 1;2))
	#else
		'<p class="err">'v_Ed' &gt;'v_Rd_cs'. Check is NOT satisfied. Increase shear reinforcement area.</p>
	#end if
	'<img style="width:225pt;" style="display:inline;" src="../../Images/structures/rc/design/punching-reinf-plan.png" alt="punching-reinf-plan.png">
	'<img style="width:260pt;" src="../../Images/structures/rc/design/punching-reinf-section.png" alt="punching-reinf-section.png">
#end if
#end post
'</div>
