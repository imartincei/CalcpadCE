     <span class="b1">(</span>
     <span class="dvc">
      74.95
      <i>kNm</i>
      <span class="dvl">
      </span>
      157
      <i>kNm</i>
     </span>
     <span class="b1">)</span>
     <sup class="raised">2</sup>
     = 0.886
    </span>
    - for cracked section
