      <var>I</var>
      <sub>red</sub>
      <span class="dvl">
      </span>
      <var>z</var>
      <sub>c</sub>
     </span>
     =
     <span class="dvc">
      2.56
      <i>MPa</i>
      · 11521310457
      <i>mm</i>
      <sup class="unit">4</sup>
      <span class="dvl">
      </span>
      394.28
      <i>mm</i>
     </span>
     = 74.95
     <i>kNm</i>
    </span>
   </p>
