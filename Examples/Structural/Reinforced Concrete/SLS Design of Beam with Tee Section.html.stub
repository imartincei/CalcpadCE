      <i>mm</i>
     </span>
     = 0.892
    </span>
   </p>
   <p>
    <span class="eq">
     <var>α</var>
     <sub>ds1</sub>
     = 4
    </span>
    - for cement Class N
   </p>
   <p>
    <span class="eq">
     <var>α</var>
     <sub>ds2</sub>
     = 0.12
    </span>
    - for cement Class N
   </p>
   <p class="ref">(eq. B.12)</p>
   <p>
    <span class="eq">
     <var>β</var>
     <sub>RH</sub>
     = 1.55 ·
     <span class="b1">(</span>
     1 −
     <span class="b1">(</span>
     <span class="dvc">
      <var>RH</var>
      <span class="dvl">
      </span>
      100
     </span>
     <span class="b1">)</span>
     <sup class="raised">3</sup>
     <span class="b1">)</span>
     = 1.55 ·
     <span class="b1">(</span>
