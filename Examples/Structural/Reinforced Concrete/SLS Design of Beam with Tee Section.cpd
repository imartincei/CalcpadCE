'<!-- Serviceability checks for a T-beam: same stress, crack-width and deflection verifications as the rectangular variant, with the cracked-section second moment of area derived for both flange-in-compression and web-in-compression cases. -->
'<small>According to <strong>Eurocode</strong>: EN 1992-1-1</small>
'<div style="max-width:180mm">
'<h4>Static scheme</h4>
#UI {"type": "dropdown", "keys": ["Cantilever with concentrated load", "Cantilever with uniformly distributed load", "Simply supported beam with concentrated load", "Simply supported beam with uniformly distributed load"], "values": ["1", "2", "3", "0"]} 'Static scheme -'type = 0
#if type ≡ 1
	'<img class="side" src="../../Images/structures/rc/design/deflection-cantilever-force.png" alt="deflection-cantilever-force.png" style="width:150pt;">
	#post
	'Cantilever with concentrated load
	#end post
#else if type ≡ 2
	'<img class="side" src="../../Images/structures/rc/design/deflection-cantilever-uniform.png" alt="deflection-cantilever-uniform.png" style="width:150pt;">
	#post
	'Cantilever with uniformly distributed load
	#end post
#else if type ≡ 3
	'<img class="side" src="../../Images/structures/rc/design/deflection-beam-force.png" alt="deflection-beam-force.png" style="width:150pt;">
	#post
	'Simply supported beam with concentrated load
	#end post
#else if type ≡ 0
	'<img class="side" src="../../Images/structures/rc/design/deflection-beam-uniform.png" alt="deflection-beam-uniform.png" style="width:150pt;">
	#post
	'Simply supported beam with uniformly distributed load
	#end post
#end if
#UI 'Beam length -'L = 5.75m
#UI {"type": "dropdown", "keys": ["X0 or XC1", "XC2, XC3, XC4, XD1, XD2, XS2 or XS3"], "values": ["0.4mm", "0.3mm"]} 'Exposure class, limiting crack width -'w_max = 0.4mm
#post
#if w_max ≡ 0.4mm
	'X0 or XC1
#else
	'XC2, XC3, XC4, XD1, XD2, XS2 or XS3
#end if
#end post
'
'<h4>Bending moments</h4>
#UI 'Characteristic combination (<i>g</i> + <i>q</i>) -'M_k = 200kNm
#UI 'Quasi-permanent combination (<i>g</i> + <i>ψ</i><sub>2</sub><i>q</i>) -'M_qp = 157kNm
'
'<img class="side" src="../../Images/structures/rc/design/beam-tsection.png" alt="beam-tsection.png" style="width:150pt;">
'<h4>Cross section dimensions</h4>
#UI 'Stem:'b = 250mm','h = 550mm
#UI 'Flange:'b_f = 2400mm','h_f = 140mm
#UI 'Concrete cover -'c = 30mm' (to bars surface)
'<p><b>Tension reinforcement</b></p>
#UI 'Bar count -'n_1 = 4
#UI {"type": "dropdown", "keys": ["Ø8", "Ø10", "Ø12", "Ø14", "Ø16", "Ø18", "Ø20", "Ø22", "Ø25", "Ø28", "Ø32"], "values": ["8mm", "10mm", "12mm", "14mm", "16mm", "18mm", "20mm", "22mm", "25mm", "28mm", "32mm"]} 'Bar diameter -'Φ_1 = 20mm
#post
'Reinforcement area -'A_s1 = n_1*π*Φ_1^2/4|mm^2
#end post
#UI 'Concrete cover to the center of reinforcement -'d_1 = 45mm
#post
'Effective cross section depth -'d = h - d_1|mm
#end post
#UI 'Spacing between bar centers -'s = 50mm
'<p><b>Compression reinforcement</b></p>
#UI 'Bar count -'n_2 = 2
#UI {"type": "dropdown", "keys": ["Ø8", "Ø10", "Ø12", "Ø14", "Ø16", "Ø18", "Ø20", "Ø22", "Ø25", "Ø28", "Ø32"], "values": ["8mm", "10mm", "12mm", "14mm", "16mm", "18mm", "20mm", "22mm", "25mm", "28mm", "32mm"]} 'Bar diameter -'Φ_2 = 8mm
#post
'Reinforcement area -'A_s2 = n_2*π*Φ_2^2/4|mm^2
#end post
#UI 'Concrete cover to the center of reinforcement -'d_2 = 45mm
'
'<h4>Material properties</h4>
'<p><b>Concrete</b> [EN 1992-1-1, Table 3.1]</p>
#UI 'Characteristic compressive cylinder strength -'f_ck = 25MPa
#post
'Mean value of cylinder compressive strength -'f_cm = f_ck + 8MPa|MPa
'Mean value of axial tensile strength -'f_ctm = 0.30*(f_ck/1MPa)^(2/3)*1MPa|MPa
'Secant modulus of elasticity -'E_cm = 22GPa*(f_cm/10MPa)^0.3|GPa
#end post
'<p><b>Steel</b></p>
#UI 'Characteristic yield strength -'f_yk = 500MPa
#post
'Modulus of elasticity -'E_s = 200GPa
'Ratio of steel to concrete moduli of elasticity -'α = E_s/E_cm
'
'<div class="fold">
#end post
'<h4>Concrete creep and shrinkage</h4>
'<p class = "ref">[EN 1992-1-1 B.1(1)]</p>
'<p><b>Creep</b></p>
#UI 'Relative humidity of the environment, %'RH = 60
#post
'Perimeter of cross section in contact with the atmosphere
u = 2*(b + h)|mm
'Cross section area -'A_c = b*h|mm^2
'Notional size of the cross section
'<p class = "ref">(eq. B.6)</p>
h_0 = 2*A_c/u|mm
'Relative humidity factor
#if f_cm ≤ 35MPa
	'<p class = "ref">(eq. B.3a)</p>
	φ_RH = (1 + (1 - RH/100)/(0.1*(h_0/1mm)^0.333))
#else
	'<p class = "ref">(eq. B.8c)</p>
	α_1 = (35MPa/f_cm)^0.7','α_2 = (35MPa/f_cm)^0.2
	'<p class = "ref">(eq. B.3b)</p>
	φ_RH = (1 + (1 - RH/100)/(0.1*(h_0/1mm)^0.333)*α_1)*α_2
#end if
'Concrete strength factor
'<p class = "ref">(eq. B.4)</p>
β_f_cm = 16.8/sqr(f_cm/1MPa)
#UI 'Concrete age at the moment of loading -'t_0 = 28d
'Concrete age factor
'<p class = "ref">(eq. B.5)</p>
β_t0 = 1/(0.1 + (t_0/1d)^0.20)
'Notional creep coefficient
'<p class = "ref">(eq. B.2)</p>
φ_8_t0 = φ_RH*β_f_cm*β_t0
'Effective concrete modulus of elasticity
'<p class = "ref">[EN 1992-1-1 §7.4.3(5)]</p>
E_c_eff = E_cm/(1 + φ_8_t0)|GPa
'Effective ratio of modules of elasticity
'<p class = "ref">[EN 1992-1-1 §7.4.3(6)]</p>
α_e = E_s/E_c_eff
'<p class = "ref">[EN 1992-1-1 B.2(1)]</p>
'<p><b>Shrinkage</b></p>
'Coefficient depending on the notional size
#if h_0 ≤ 100mm
	k_h = 1.00
#else if h_0 ≤ 200mm
	k_h = 1.00 - 0.0015*(h_0 - 100mm)/1mm
#else if h_0 ≤ 300mm
	k_h = 0.85 - 0.001*(h_0 - 200mm)/1mm
#else if h_0 ≤ 500mm
	k_h = 0.75 - 0.00025*(h_0 - 300mm)/1mm
#else
	k_h = 0.70
#end if
α_ds1 = 4'- for cement Class N
α_ds2 = 0.12'- for cement Class N
'<p class = "ref">(eq. B.12)</p>
β_RH = 1.55*(1 - (RH/100)^3)
'Basic drying shrinkage strain
'<p class = "ref">(eq. B.11)</p>
ε_cd0 = 0.85*(220 + 110*α_ds1)*e^(-α_ds2*f_cm/10MPa)*10^-6*β_RH
'<p class = "ref">[EN 1992-1-1 §3.1.4(6)]</p>
'Drying shrinkage strain in time
'<p class = "ref">(eq. 3.9)</p>
ε_cd = k_h*ε_cd0
'Autogenous shrinkage strain
'<p class = "ref">(eq. 3.11)</p>
ε_ca = 2.5*(f_ck - 10MPa)/1MPa*10^(-6)
'Total shrinkage strain
'<p class = "ref">(eq. 3.8)</p>
ε_cs = ε_cd + ε_ca
'</div>
'
'<div class="fold">
'<h4>Cross section properties</h4>
'Total reinforcement area -'A_s = A_s1 + A_s2|mm^2
'Flange area -'A_f = (b_f - b)*h_f|mm^2
'T-section area -'A_c = b*h + A_f|mm^2
'Effective section area
A_red = A_c + α_e*A_s|mm^2
'Section modulus about the bottom edge
S_c = b*h^2/2 + A_f*(h - h_f/2)|mm^3
'Effective section modulus about the bottom edge
S_red = S_c + α_e*(A_s1*d_1 + A_s2*(h - d_2))|mm^3
'Effective depth of cross section center
z_c = S_red/A_red|mm
'Second moment of area of the concrete section
I_c = (b*h^3 + (b_f - b)*h_f^3)/12 + b*h*(z_c - h/2)^2 + A_f*((h - z_c - h_f/2)^2)|mm^4
'Effective second moment of area for uncracked section
I_red = I_c + α_e*(A_s1*(z_c - d_1)^2 + A_s2*(h - z_c - d_2)^2)|mm^4
'Uncracked section properties for SLS
'Equivalent bending moment and axial force due to concrete stress about the neutral axis
N_c(x) = b_f*x^2/2 - (x - h_f)^2*(b_f - b)/2*(x > h_f)
'Equivalent axial force due to internal stress
N_bal(x) = N_c(x) + α_e*(A_s2*(x - d_2) - A_s1*(d - x))
'Depth of neutral axis
x = $Root{N_bal(x) @ x = 0mm : h}|mm
'Second moment of area for cracked section
#if x > h_f
	I_red_II = b_f*x^3/3 - (x - h_f)^3*(b_f - b)/3 + α_e*(A_s1*(d - x)^2 + A_s2*(x - d_2)^2)|mm^4
#else
	I_red_II = b_f*x^3/3 + α_e*(A_s1*(d - x)^2 + A_s2*(x - d_2)^2)|mm^4
#end if
'</div>
'
'<div class="fold">
'<h4>Control of concrete stress</h4>
'<p><b>Characteristic combination</b></p>
'Stress at the bottom edge of the section
σ_ct = M_k/I_red*z_c|MPa
'Check for crack opening
#if σ_ct ≤ f_ctm
	σ_ct' &lе;'f_ctm' - section is uncracked
	'Concrete stress (uncracked section)
	σ_c = M_k/I_red*(h - z_c)|MPa
	'Reinforcement stress (uncracked section)
	σ_s1 = α_e*M_k/I_red*(z_c - d_1)|MPa
	σ_s2 = -α_e*M_k/I_red*(h - z_c - d_2)|MPa
#else
	σ_ct' &gt;'f_ctm' - section is cracked
	'Concrete stress (cracked section)
	σ_c = M_k/I_red_II*x|MPa
	'Reinforcement stress (cracked section)
	σ_s1 = α_e*M_k/I_red_II*(d - x)|MPa
	σ_s2 = -α_e*M_k/I_red_II*(x - d_2)|MPa
#end if
'<p><b>Stress limitation</b></p>
'<p class = "ref">[EN 1992-1-1 §7.2(2)]</p>
'Concrete stress,'k_1 = 0.60
#if σ_c > k_1*f_ck
	σ_c' &gt;'k_1*f_ck' - <span class="err">The condition is NOT satisfied!</span>
#else
	σ_c' &le;'k_1*f_ck' - The condition is satisfied!
#end if
'<p class = "ref">[EN 1992-1-1 §7.2(5)]</p>
'Reinforcement stress,'k_3 = 0.80
#if σ_s1 > k_3*f_yk
	σ_s1' &gt;'k_3*f_yk' - <span class="err">The condition is NOT satisfied!</span>
#else
	σ_s1' &le;'k_3*f_yk' - The condition is satisfied
#end if
'<p><b>Quasi-permanent combination</b></p>
#if σ_ct ≤ f_ctm
	'Concrete stress for uncracked section
	σ_c = M_qp/I_red*(h - z_c)|MPa
#else
	'Concrete stress for cracked section
	σ_c = M_qp/I_red_II*x|MPa
#end if
'<p class = "ref">[EN 1992-1-1 §7.2(3)]</p>
'Stress limitation,'k_2 = 0.45
#if σ_c > k_2*f_ck
	σ_c' &gt;'k_2*f_ck' - <span class="err">The condition is NOT satisfied!</span>
	'<p class = "ref">[EN 1992-1-1 §3.1.4(4)]</p>
	'Non-linear creep must be considered!
	k_σ = σ_c/f_ck
	'Non-linear notional creep coefficient
	φ_k_8_t0 = φ_8_t0*e^(1.5*(k_σ - 0.45))
	'Effective concrete modulus of elasticity
	E_c_eff = E_cm/(1 + φ_k_8_t0)|MPa
#else
	σ_c' &le;'k_2*f_ck' - The condition is satisfied!
	'Non-linear creep is NOT calculated!
#end if
'</div>
'
'<div class="fold">
'<h4>Control of cracks</h4>
'<p class = "ref">[EN 1992-1-1 §7.3.2(2)]</p>
'<p><b>Minimum reinforcement area</b></p>
'Allowable reinforcement stress -'σ_s = f_yk|MPa
'Approximate value of axial tensile strength -'f_ct_eff = f_ctm|MPa
'Area of tensile zone before opening of first crack
A_ct = b*z_c|mm^2
#if h ≤ 300mm
	k = 1'- for h ≤ 300
#else if h ≥ 800mm
	k = 0.65'- for h ≥ 800
#else
	k = 1 - 0.35*(h - 300mm)/500mm'- for 300 &lt; h &lt; 800
#end if
	k_c = 0.4
#if h ≤ 1000mm
	h_1 = h'- for h ≤ 1000
#else
	h_1 = 1000mm'- for h &gt; 1000
#end if
'Minimum reinforcement
A_s_min = k_c*k*f_ct_eff*A_ct/σ_s|mm^2
#if A_s1 < A_s_min
	A_s1' &lt;'A_s_min' - <span class="err">The condition is NOT satisfied!</span>
#else
	A_s1' &ge;'A_s_min' - The condition is satisfied!
#end if
'<p><b>Calculation of crack widths</b></p>
'<p class = "ref">[EN 1992-1-1 §7.3.2(3)]</p>
'Depth of the effective area
h_c_eff = min(2.5*(h - d);min(h - x/3;h/2))|mm
'Concrete effective area within tensile zone
A_c_eff = b*h_c_eff|mm^2
ρ_p_eff = A_s1/A_c_eff
'<p class = "ref">[EN 1992-1-1 §7.3.4(3)]</p>
#if s > 5*(c + Φ_1/2)
	'For's' &gt;'5*(c + Φ_1/2)':
	'Maximum final crack spacing -'s_r_max = 1.3*(h - x)|mm
#else
	'For's' &le;'5*(c + Φ_1/2)':
	k_1 = 0.8'- for high bond bars
	k_2 = 0.5'- for bending
	k_3 = 3.4','k_4 = 0.425
	'Maximum final crack spacing
	s_r_max = k_3*c + k_1*k_2*k_4*Φ_1/ρ_p_eff|mm
#end if
'The check is performed for quasi-permanent combination
'Reinforcement stress
σ_s = α_e*M_qp/I_red_II*(d - x)|MPa
'Long-term load factor -'k_t = 0.4
'<p class = "ref">[EN 1992-1-1 §7.3.4(2)]</p>
'Difference between mean values of concrete and reinforcement strains
'<p><i>ε</i><sub>sm</sub> - <i>ε</i><sub>cm</sub> ='Δε = max((σ_s - k_t*f_ct_eff/ρ_p_eff*(1 + α*ρ_p_eff));0.6*σ_s)/E_s'</p>
'<p class = "ref">[EN 1992-1-1 §7.3.4(1)]</p>
'Crack widths
w_k = s_r_max*Δε|mm
'<p class = "ref">[EN 1992-1-1 §7.3.1(5)]</p>
'Limiting crack width value
'<p class = "ref">[EN 1992-1-1, Table NA.4]</p>
#if w_max ≡ 0.4mm
	w_max' - for exposure classes X0, XC1
#else
	w_max' - for exposure classes XC2, XC3, XC4, XD1, XD2, XS2, XS3
#end if
'Crack width limitation
'</div>
#if w_k > w_max
	w_k' &gt;'w_max' - <span class="err">The condition is NOT satisfied!</span>
#else
	w_k' &le;'w_max' - The condition is satisfied!
#end if
'
'<div class="fold">
'<h4>Control of deflections</h4>
'Crack opening moment
#if σ_ct ≤ f_ctm
	'Distribution coefficient
	'<p class = "ref">[EN 1992-1-1 §7.4.3(3)]</p>
	ζ = 0'- for uncracked section
#else
	M_cr = f_ctm*I_red/z_c|kNm
	'Coefficient for duration of loads
	β = 0.5'- for long-term loads
	'<p class = "ref">[EN 1992-1-1 §7.4.3(3)]</p>
	'Distribution coefficient
	ζ = 1 - β*(M_cr/M_qp)^2'- for cracked section
#end if
'<p><b>Calculation of curvature</b></p>
'First moment of reinforcement area about centroid of uncracked section
S = A_s1*(z_c - d_1) - A_s2*(h - z_c - d_2)|mm^3
'Curvature due to shrinkage of uncracked section
'<p class = "ref">[EN 1992-1-1 §7.4.3(6)]</p>
θ_cs_I = ε_cs*α_e*S/I_red|mm^-1
'Curvature of uncracked section
θ_I = M_qp/(E_c_eff*I_red) + θ_cs_I|mm^-1
'First moment of reinforcement area about centroid of cracked section
S = A_s1*(d - x) - A_s2*(x - d_2)|mm^3
'Curvature due to shrinkage of cracked section
'<p class = "ref">[EN 1992-1-1 §7.4.3(6)]</p>
θ_cs_II = ε_cs*α_e*S/I_red_II|mm^-1
'Curvature of cracked section
θ_II = M_qp/(E_c_eff*I_red_II) + θ_cs_II|mm^-1
'Total curvature
'<p class = "ref">[EN 1992-1-1 §7.4.3(3)]</p>
θ = ζ*θ_II + (1 - ζ)*θ_I|mm^-1
'Factor considering the static scheme
#if type ≡ 1
	k = 1/3'- for cantilever with concentrated load
#else if type ≡ 2
	k = 1/4'- for cantilever with uniformly distributed load
#else if type ≡ 3
	k = 1/12'- for simply supported beam with concentrated load
#else if type ≡ 0
	k = 5/48'- for simply supported beam with uniformly distributed load
#end if
'Deflection due to quasi-permanent combination -'δ = k*θ*L^2|mm
'<p class = "ref">[EN 1992-1-1 §7.4.1(4)]</p>
#if (type ≡ 1) + (type ≡ 2)
	'Maximum deflection -'δ_max = L/125|mm
#else
	'Maximum deflection -'δ_max = L/250|mm
#end if
'Deflection check:
'</div>
#if δ > δ_max
	δ' &gt;'δ_max' - <span class="err">The condition is NOT satisfied!</span>
#else
	δ' &le;'δ_max' - The condition is satisfied!
#end if
#end post
'</div>
