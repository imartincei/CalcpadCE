     = 14
     <i>cm</i>
     − 2
     <i>cm</i>
     −
     <span class="dvc">
      8
      <i>mm</i>
      <span class="dvl">
      </span>
      2
     </span>
     = 11.6
     <i>cm</i>
    </span>
   </p>
   <p>
    Relative design bending moment -
    <span class="eq">
     <var>m</var>
     <sub>Ed</sub>
     =
     <span class="dvc">
      <var>M</var>
      <sub>Ed_xb</sub>
      <span class="dvl">
      </span>
      <var>d</var>
      <sub>xb</sub>
      <sup>2</sup>
      ·
      <var>η</var>
      ·
      <var>f</var>
      <sub>cd</sub>
     </span>
     =
     <span class="dvc">
      11.28
      <i>kNm</i>
      <i class="unit">∕</i>
      <i>m</i>
      <span class="dvl">
      </span>
      ( 11.6
      <i>cm</i>
      )
      <sup>2</sup>
      · 1 · 14.17
      <i>MPa</i>
     </span>
     = 0.0592
    </span>
   </p>
   <p>
    Compression zone depth -
    <span class="eq">
     <var>x</var>
     =
     <span class="dvc">
      <var>d</var>
      <sub>xb</sub>
      <span class="dvl">
      </span>
      <var>λ</var>
     </span>
     ·  ( 1 −
     <span class="o0">
      <span class="r">√</span>
      1 − 2 ·
      <var>m</var>
      <sub>Ed</sub>
     </span>
     )  =
     <span class="dvc">
      11.6
      <i>cm</i>
      <span class="dvl">
      </span>
      0.8
     </span>
     ·  ( 1 −
     <span class="o0">
      <span class="r">√</span>
      1 − 2 · 0.0592
     </span>
     )  = 0.885
     <i>cm</i>
    </span>
   </p>
   <p>
    Relative compression zone depth -
    <span class="eq">
     <var>ξ</var>
     =
     <span class="dvc">
      <var>x</var>
      <span class="dvl">
      </span>
      <var>d</var>
      <sub>xb</sub>
     </span>
     =
     <span class="dvc">
      0.885
      <i>cm</i>
      <span class="dvl">
      </span>
      11.6
      <i>cm</i>
     </span>
     = 0.0763
    </span>
   </p>
   <p>
    Lever arm of internal forces -
    <span class="eq">
     <var>z</var>
     =
     <var>d</var>
     <sub>xb</sub>
     − 0.5 ·
     <var>λ</var>
     ·
     <var>x</var>
     = 11.6
     <i>cm</i>
     − 0.5 · 0.8 · 0.885
     <i>cm</i>
     = 11.25
     <i>cm</i>
    </span>
   </p>
   <p>
    Area of required reinforcement -
    <span class="eq">
     <var>A</var>
     <sub>sxb</sub>
     =
     <span class="dvc">
      <var>M</var>
      <sub>Ed_xb</sub>
      <span class="dvl">
      </span>
      <var>z</var>
      ·
      <var>f</var>
      <sub>yd</sub>
     </span>
     =
     <span class="dvc">
      11.28
      <i>kNm</i>
      <i class="unit">∕</i>
      <i>m</i>
      <span class="dvl">
      </span>
      11.25
      <i>cm</i>
      · 434.78
      <i>MPa</i>
     </span>
     = 2.31
     <i>cm</i>
     <sup class="unit">2</sup>
     <i class="unit">∕</i>
     <i>m</i>
    </span>
   </p>
   <p>
    Reinforcement ratio -
    <span class="eq">
     <var>ρ</var>
     <sub>xb</sub>
     =
     <span class="dvc">
      <var>A</var>
      <sub>sxb</sub>
      <span class="dvl">
      </span>
      <var>d</var>
      <sub>xb</sub>
     </span>
     =
     <span class="dvc">
      2.31
      <i>cm</i>
      <sup class="unit">2</sup>
      <i class="unit">∕</i>
      <i>m</i>
      <span class="dvl">
      </span>
      11.6
      <i>cm</i>
     </span>
     = 0.00199
    </span>
   </p>
   <p>
    <b>The rest of the reinforcement is calculated similarly.</b>
   </p>
  </div>
  <div class="fold">
   <h4>Reinforcement detailing</h4>
   <p>
    <b>Bottom reinforcement</b>
   </p>
   <p class="ref">[EN 1992-1-1, § 9.2.1.1 (1)]</p>
   <p>Minimum reinforcement ratio</p>
   <p>
    <span class="eq">
     <var>ρ</var>
     <sub>min</sub>
     =
     <b>max</b>
     <span class="b1">(</span>
     <span class="dvc">
      0.26 ·
      <var>f</var>
      <sub>ctm</sub>
      <span class="dvl">
      </span>
      <var>f</var>
      <sub>yk</sub>
     </span>
     ; 0.0013
     <span class="b1">)</span>
     =
     <b>max</b>
     <span class="b1">(</span>
     <span class="dvc">
      0.26 · 2.56
      <i>MPa</i>
      <span class="dvl">
      </span>
      500
      <i>MPa</i>
     </span>
     ; 0.0013
     <span class="b1">)</span>
     = 0.00133
    </span>
   </p>
   <p class="ref">[EN 1992-1-1, § 9.2.1.1 (3)]</p>
   <p>
    Maximum reinforcement ratio -
    <span class="eq">
     <var>ρ</var>
     <sub>max</sub>
     = 0.04
    </span>
   </p>
   <!--
<p><i>ρ</i><sub>yb</sub> &lt; <i>ρ</i><sub>min</sub>. Minimum reinforcement is assumed -  <span class="eq"><var>A</var><sub>syb</sub> = <var>ρ</var><sub>min</sub> · <var>d</var><sub>yb</sub> = 0.00133 · 10.8 <i>cm</i> = 1.44 <i>cm</i><sup class="unit">2</sup><i class="unit"> ∕ </i><i>m</i></span> </p>
<-->
   <p>Required bar spacing</p>
   <p>
    <span class="eq">
     <var>s</var>
     <sub>xb</sub>
     =
     <b>floor</b>
     <span class="b2">(</span>
     <span class="dvc down">
      <span class="dvc up">
       <span class="dvc">
        <var>π</var>
        ·
        <var>d</var>
        <sub>bxb</sub>
        <sup>2</sup>
        <span class="dvl">
        </span>
        4 ·
        <var>A</var>
        <sub>sxb</sub>
       </span>
       <span class="dvl">
       </span>
       1
       <i>cm</i>
      </span>
     </span>
     <span class="b2">)</span>
     · 1
     <i>cm</i>
     =
     <b>floor</b>
     <span class="b2">(</span>
     <span class="dvc down">
      <span class="dvc up">
       <span class="dvc">
        3.14 ·  ( 8
        <i>mm</i>
        )
        <sup>2</sup>
        <span class="dvl">
        </span>
        4 · 2.31
        <i>cm</i>
        <sup class="unit">2</sup>
        <i class="unit">∕</i>
        <i>m</i>
       </span>
       <span class="dvl">
       </span>
       1
       <i>cm</i>
      </span>
     </span>
     <span class="b2">)</span>
     · 1
     <i>cm</i>
     = 21
     <i>cm</i>
    </span>
   </p>
   <!-- <span class="eq"><var>s</var><sub>yb</sub> = <b>floor</b><span class="b2">(</span><span class="dvc down"><span class="dvc up"><span class="dvc"><var>π</var> · <var>d</var><sub>byb</sub><sup>2</sup><span class="dvl"></span>4 · <var>A</var><sub>syb</sub></span><span class="dvl"></span>1 <i>cm</i></span></span><span class="b2">)</span> · 1 <i>cm</i> = <b>floor</b><span class="b2">(</span><span class="dvc down"><span class="dvc up"><span class="dvc">3.14 ·  ( 8 <i>mm</i> ) <sup>2</sup><span class="dvl"></span>4 · 1.44 <i>cm</i><sup class="unit">2</sup><i class="unit"> ∕ </i><i>m</i></span><span class="dvl"></span>1 <i>cm</i></span></span><span class="b2">)</span> · 1 <i>cm</i> = 34 <i>cm</i></span> -->
   <p class="ref">[EN 1992-1-1, § 9.3.1.1 (3)]</p>
   <p>Maximum bar spacing</p>
   <p>
    <span class="eq">
     <var>s</var>
     <sub>max</sub>
     =
     <b>min</b>
     ( 2 ·
     <var>h</var>
     ; 25
     <i>cm</i>
     )  =
     <b>min</b>
     ( 2 · 14
     <i>cm</i>
     ; 25
     <i>cm</i>
     )  = 25
     <i>cm</i>
    </span>
   </p>
   <!--<p><i>s</i><sub>yb</sub> &gt; <i>s</i><sub>max</sub>. Assume <span class="eq"><var>s</var><sub>yb</sub> = <var>s</var><sub>max</sub> = 25 <i>cm</i></span> </p>-->
   <p>
    <b>The rest of the reinforcement is detailed similarly.</b>
   </p>
