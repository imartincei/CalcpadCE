     <td>0.47</td>
     <td>0.49</td>
     <td>0.51</td>
     <td>0.55</td>
     <td>0.59</td>
    </tr>
   </table>
   <p>
    <span class="eq">
     <var>β</var>
     <sub>vx1</sub>
     = 0.32 +
     <span class="dvc">
      ( 0.34 − 0.32 )  ·  (
      <var>k</var>
      − 1.4 )
      <span class="dvl">
      </span>
      0.1
     </span>
     = 0.32 +
     <span class="dvc">
      ( 0.34 − 0.32 )  ·  ( 1.48 − 1.4 )
      <span class="dvl">
      </span>
      0.1
     </span>
     = 0.337
    </span>
   </p>
   <p>
    <span class="eq">
     <var>β</var>
     <sub>vx2</sub>
     = 0.49 +
     <span class="dvc">
      ( 0.51 − 0.49 )  ·  (
      <var>k</var>
      − 1.4 )
      <span class="dvl">
      </span>
      0.1
     </span>
     = 0.49 +
     <span class="dvc">
