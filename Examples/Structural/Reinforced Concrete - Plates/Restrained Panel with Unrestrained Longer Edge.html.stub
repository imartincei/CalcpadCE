    <sub>G</sub>
    +
    <var>q</var>
    <sub>k</sub>
    ·
    <var>γ</var>
    <sub>Q</sub>
    =  ( 3.5
    <i>kN</i>
    <i class="unit">∕</i>
    <i>m</i>
    <sup class="unit">2</sup>
    + 2.5
    <i>kN</i>
    <i class="unit">∕</i>
    <i>m</i>
    <sup class="unit">2</sup>
    )  · 1.35 + 2
    <i>kN</i>
    <i class="unit">∕</i>
    <i>m</i>
    <sup class="unit">2</sup>
    · 1.5 = 11.1
    <i>kN</i>
    <i class="unit">∕</i>
    <i>m</i>
    <sup class="unit">2</sup>
   </span>
  </p>
