    <b>min</b>
    (
    <var>b</var>
    <sub>y</sub>
    ;
    <var>h</var>
    )  = 6
    <i>m</i>
    +
    <b>min</b>
    ( 25
    <i>cm</i>
    ; 14
    <i>cm</i>
    )  = 6.14
    <i>m</i>
   </span>
  </p>
  <p>
   Span ratio -
   <span class="eq">
    <var>k</var>
