     <sub>x</sub>
     = 0.447 · 11.1
     <i>kN</i>
     <i class="unit">∕</i>
     <i>m</i>
     <sup class="unit">2</sup>
     · 4.14
     <i>m</i>
     = 20.52
     <i>kN</i>
     <i class="unit">∕</i>
     <i>m</i>
    </span>
   </p>
   <p>
    <span class="eq">
     <var>V</var>
     <sub>Ed_y</sub>
     =
     <var>β</var>
     <sub>vy</sub>
     ·
     <var>p</var>
     ·
     <var>l</var>
     <sub>x</sub>
     = 0.33 · 11.1
     <i>kN</i>
     <i class="unit">∕</i>
     <i>m</i>
     <sup class="unit">2</sup>
     · 4.14
     <i>m</i>
     = 15.16
     <i>kN</i>
     <i class="unit">∕</i>
     <i>m</i>
    </span>
   </p>
  </div>
  <div class="fold">
   <h4>Bending design</h4>
   <p>
    <b>
     Bottom reinforcement parallel to
     <i>x</i>
    </b>
   </p>
   <p>
    Effective cross section depth -
    <span class="eq">
     <var>d</var>
     <sub>xb</sub>
     =
     <var>h</var>
     −
     <var>c</var>
     −
     <span class="dvc">
      <var>d</var>
      <sub>bxb</sub>
      <span class="dvl">
      </span>
      2
     </span>
     = 14
     <i>cm</i>
     − 2
     <i>cm</i>
     −
     <span class="dvc">
      8
      <i>mm</i>
      <span class="dvl">
      </span>
      2
     </span>
     = 11.6
     <i>cm</i>
    </span>
   </p>
   <p>
    Relative design bending moment -
    <span class="eq">
     <var>m</var>
     <sub>Ed</sub>
     =
     <span class="dvc">
      <var>M</var>
      <sub>Ed_xb</sub>
      <span class="dvl">
      </span>
      <var>d</var>
      <sub>xb</sub>
      <sup>2</sup>
      ·
      <var>η</var>
      ·
      <var>f</var>
      <sub>cd</sub>
     </span>
     =
     <span class="dvc">
      17.34
      <i>kNm</i>
      <i class="unit">∕</i>
      <i>m</i>
      <span class="dvl">
      </span>
      ( 11.6
      <i>cm</i>
      )
      <sup>2</sup>
      · 1 · 14.17
      <i>MPa</i>
     </span>
     = 0.091
    </span>
   </p>
   <p>
    Compression zone depth -
    <span class="eq">
     <var>x</var>
     =
     <span class="dvc">
      <var>d</var>
      <sub>xb</sub>
      <span class="dvl">
      </span>
      <var>λ</var>
     </span>
     ·  ( 1 −
     <span class="o0">
      <span class="r">√</span>
      1 − 2 ·
      <var>m</var>
      <sub>Ed</sub>
     </span>
     )  =
     <span class="dvc">
      11.6
      <i>cm</i>
      <span class="dvl">
      </span>
      0.8
     </span>
     ·  ( 1 −
     <span class="o0">
      <span class="r">√</span>
      1 − 2 · 0.091
     </span>
     )  = 1.39
     <i>cm</i>
    </span>
   </p>
   <p>
    Relative compression zone depth -
    <span class="eq">
     <var>ξ</var>
     =
     <span class="dvc">
      <var>x</var>
      <span class="dvl">
      </span>
      <var>d</var>
      <sub>xb</sub>
     </span>
     =
     <span class="dvc">
      1.39
      <i>cm</i>
      <span class="dvl">
      </span>
      11.6
      <i>cm</i>
     </span>
     = 0.119
    </span>
   </p>
   <p>
    Lever arm of internal forces -
    <span class="eq">
     <var>z</var>
     =
     <var>d</var>
     <sub>xb</sub>
     − 0.5 ·
     <var>λ</var>
     ·
     <var>x</var>
     = 11.6
     <i>cm</i>
     − 0.5 · 0.8 · 1.39
     <i>cm</i>
     = 11.05
     <i>cm</i>
    </span>
   </p>
   <p>
    Area of required reinforcement -
    <span class="eq">
     <var>A</var>
     <sub>sxb</sub>
     =
     <span class="dvc">
      <var>M</var>
      <sub>Ed_xb</sub>
      <span class="dvl">
      </span>
      <var>z</var>
      ·
      <var>f</var>
      <sub>yd</sub>
     </span>
     =
     <span class="dvc">
      17.34
      <i>kNm</i>
      <i class="unit">∕</i>
      <i>m</i>
      <span class="dvl">
      </span>
      11.05
      <i>cm</i>
      · 434.78
      <i>MPa</i>
     </span>
     = 3.61
     <i>cm</i>
     <sup class="unit">2</sup>
     <i class="unit">∕</i>
     <i>m</i>
    </span>
   </p>
   <p>
    Reinforcement ratio -
    <span class="eq">
     <var>ρ</var>
     <sub>xb</sub>
     =
     <span class="dvc">
      <var>A</var>
      <sub>sxb</sub>
      <span class="dvl">
      </span>
      <var>d</var>
      <sub>xb</sub>
     </span>
     =
     <span class="dvc">
      3.61
      <i>cm</i>
      <sup class="unit">2</sup>
      <i class="unit">∕</i>
      <i>m</i>
      <span class="dvl">
      </span>
      11.6
      <i>cm</i>
     </span>
     = 0.00311
    </span>
   </p>
   <p>
    <b>The rest of the reinforcement is calculated similarly.</b>
   </p>
