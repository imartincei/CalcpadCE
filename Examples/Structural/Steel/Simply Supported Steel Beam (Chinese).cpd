'<!-- Simply supported steel beam under a uniform load: bending, shear and deflection checks. 中文算例。-->
'<div style="max-width:180mm;">
#round 2
#md on
'# 📐 简支钢梁计算书

'## 一、输入参数
'**几何参数**
#UI '梁跨度 — 'L = 7.5m

'**荷载参数**
#UI '均布荷载标准值 — 'q_k = 10kN/m
'荷载分项系数 — 'γ_G = 1.3
#UI '弹性模量 — 'E = 206GPa

'**截面参数**
#UI '截面惯性矩 — 'I_y = 23170cm^4
#UI '截面高度 — 'h = 300mm
'截面塑性发展系数 — 'γ_x = 1.05
#UI '钢材抗弯强度设计值 — 'f = 215MPa
#hide

'## 二、计算
'荷载设计值
q = q_k * γ_G|kN/m

'支座反力
R_A = q * L / 2|kN

'跨中最大弯矩
M_max = q * L^2 / 8|kNm

'抗弯刚度
EI = E * I_y|kN*m^2

'跨中最大挠度（按荷载标准值）
d_max = 5 * q_k * L^4 / (384 * EI)|mm

'截面模量
W = I_y / (h / 2)|cm^3

'弯曲应力
σ = M_max / (γ_x * W)|MPa
η = σ / f
#end hide

'## 三、计算结果
'支座反力 'R_A
'跨中最大弯矩 'M_max
'跨中最大挠度 'd_max
'弯曲应力 'σ
'强度设计值 'f
'应力比 'η
#if σ ≤ f
'✅ 强度满足要求。
#else
'❌ 强度不满足要求，请增大截面。
#end if

'## 四、内力与变形简图
#hide
PlotWidth = 500
PlotHeight = 150
PlotSVG = 1
#end hide

'### 4.1 剪力简图
V(x) = q * (L/2 - x)
$Plot{-V(x) @ x = 0m : L}
'图 1 剪力简图（kN）

'### 4.2 弯矩简图
M(x) = q * x * (L - x) / 2
$Plot{-M(x) @ x = 0m : L}
'图 2 弯矩简图（kN·m）

'### 4.3 挠度简图
d(x) = q_k * x * (L^3 - 2 * L * x^2 + x^3) / (24 * EI)|mm
$Plot{-d(x) @ x = 0m : L}
'图 3 挠度简图（mm）

'## 五、任意截面验算
#UI '验算位置 — 'x_chk = 1.875m
M_chk = q * x_chk * (L - x_chk) / 2|kNm
V_chk = q * (L/2 - x_chk)|kN
d_chk = q_k * x_chk * (L^3 - 2 * L * x_chk^2 + x_chk^3) / (24 * EI)|mm
σ_chk = M_chk / (γ_x * W)|MPa
'截面弯矩 'M_chk
'截面剪力 'V_chk
'截面挠度 'd_chk
'截面应力 'σ_chk
#md off
'</div>
