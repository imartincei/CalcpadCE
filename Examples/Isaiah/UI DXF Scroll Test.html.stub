 <div id="dxf-render-container-scrolltest" style="position:fixed; left:-9999px; top:0; width:1px; height:1px; overflow:hidden;">
 </div>
 <img id="dxf-output-img-scrolltest" style="visibility:hidden; aspect-ratio:1/1; width:800px; max-width:100%; margin-top:30px; border:2px solid #ddd; border-radius:8px; background:#fff;"/>
 <div id="dxf-error-message-scrolltest" style="margin-top:20px; padding:15px; background:#f8d7da; border-radius:4px; color:#721c24; display:none;">
  <strong>Error:</strong>
  <span id="dxf-error-text-scrolltest">
  </span>
 </div>
 <script type="module">import * as THREE from "https://cdn.jsdelivr.net/npm/three@0.160.0/+esm";import * as DxfViewerModule from "https://cdn.jsdelivr.net/npm/dxf-viewer@1.0.46/+esm";const DxfViewer = DxfViewerModule.default || DxfViewerModule.DxfViewer;const dxfId = "scrolltest";const drawing = window.dxfDrawings && window.dxfDrawings[dxfId];function showError(msg) {  document.getElementById("dxf-error-text-" + dxfId).textContent = msg;  document.getElementById("dxf-error-message-" + dxfId).style.display = "block";}async function renderToImage() {  if (!DxfViewer) { throw new Error("DxfViewer library not loaded"); }  if (!drawing) { throw new Error("DXF drawing  + dxfId +  not initialized. Call initDXF first"); }  const container = document.getElementById("dxf-render-container-" + dxfId);  if (!container) { throw new Error("Render container  + dxfId +  not found"); }  const iw = 800;  const cw = iw * 2;  const viewer = new DxfViewer(container, {    autoResize: false,    canvasWidth: cw,    canvasHeight: cw,    clearColor: new THREE.Color("#fff"),    colorCorrection: true,    preserveDrawingBuffer: true  });  const blob = new Blob([drawing.toDxfString()], { type: "application/dxf" });  const url = URL.createObjectURL(blob);  await viewer.Load({ url: url });  URL.revokeObjectURL(url);  const bounds = viewer.GetBounds();  const origin = viewer.GetOrigin();  if (bounds) {    const bw = bounds.maxX - bounds.minX;    const bh = bounds.maxY - bounds.minY;    const ch = Math.max(Math.round(cw * bh / Math.max(bw, 0.001)), 1);    viewer.SetSize(cw, ch);    viewer.FitView(      bounds.minX - origin.x, bounds.maxX - origin.x,      bounds.minY - origin.y, bounds.maxY - origin.y    );  }  viewer.Render();  const dataUrl = viewer.GetCanvas().toDataURL("image/png");  const img = document.getElementById("dxf-output-img-" + dxfId);  await new Promise(function(resolve) {    img.onload = resolve;    img.onerror = resolve;    img.src = dataUrl;  });  img.style.visibility = "visible";  img.dataset.dxfReady = "ok";  viewer.Destroy();  container.remove();  console.log("DXF " + dxfId + " rendered to image successfully");}setTimeout(async function() {  try {    await renderToImage();  } catch(err) {    console.error("Failed to render DXF " + dxfId + ":", err);    showError(err.message);  }}, 100);</script>
