{
  "build": {
    "beforeDevCommand": {
      "script": "rm -rf ../calcpad-web/dist && ./local-npm.sh --prefix ../calcpad-frontend run build && ./local-npm.sh --prefix ../calcpad-web run build && (./local-npm.sh --prefix ../calcpad-frontend run watch > /tmp/calcpad-frontend-watch.log 2>&1 &) && (./local-npm.sh --prefix ../calcpad-web run build:watch > /tmp/calcpad-web-watch.log 2>&1 &)",
      "wait": true
    },
    "beforeBuildCommand": "rm -rf ../calcpad-web/dist && ./local-npm.sh --prefix ../calcpad-frontend run build && ./local-npm.sh --prefix ../calcpad-web run build"
  },
  "bundle": {
    "targets": ["deb", "rpm", "appimage"],
    "resources": {
      "binaries/*.so": "./",
      "binaries/*.dll": "./",
      "binaries/Calcpad.Server.deps.json": "./",
      "binaries/Calcpad.Server.runtimeconfig.json": "./",
      "binaries/Calcpad.Server.staticwebassets.endpoints.json": "./",
      "binaries/appsettings.json": "./",
      "binaries/Calcpad.Server": "./",
      "binaries/createdump": "./",
      "binaries/template.html": "./",
      "binaries/Fonts/*": "./Fonts/",
      "binaries/bg/*": "./bg/",
      "binaries/zh/*": "./zh/"
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "rpm": {
        "depends": []
      }
    }
  }
}
