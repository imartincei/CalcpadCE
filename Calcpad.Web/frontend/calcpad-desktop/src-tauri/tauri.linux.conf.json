{
  "build": {
    "beforeDevCommand": {
      "script": "./dev-frontend.sh",
      "wait": true
    },
    "beforeBuildCommand": "./build-frontend.sh"
  },
  "bundle": {
    "targets": ["deb", "rpm", "appimage"],
    "resources": {
      "binaries/*.so": "./",
      "binaries/*.dll": "./",
      "binaries/Calcpad.Server.deps.json": "./",
      "binaries/Calcpad.Server.runtimeconfig.json": "./",
      "binaries/Calcpad.Server.staticwebassets.endpoints.json": "./",
      "binaries/appsettings.json": "./",
      "binaries/Calcpad.Server": "./",
      "binaries/createdump": "./",
      "binaries/template.html": "./",
      "binaries/Fonts/*": "./Fonts/",
      "binaries/bg/*": "./bg/",
      "binaries/zh/*": "./zh/"
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "rpm": {
        "depends": []
      }
    }
  }
}
