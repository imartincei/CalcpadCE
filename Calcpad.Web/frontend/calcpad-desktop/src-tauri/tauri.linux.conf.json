{
  "build": {
    "beforeDevCommand": {
      "script": "./dev-frontend.sh",
      "wait": true
    },
    "beforeBuildCommand": "./build-frontend.sh"
  },
  "bundle": {
    "targets": ["deb", "rpm"],
    "resources": {
      "binaries/*.so": "./",
      "binaries/*.dll": "./",
      "binaries/Calcpad.Server.deps.json": "./",
      "binaries/Calcpad.Server.runtimeconfig.json": "./",
      "binaries/Calcpad.Server.staticwebassets.endpoints.json": "./",
      "binaries/appsettings.json": "./",
      "binaries/THIRD-PARTY-NOTICES.txt": "./",
      "binaries/LICENSE.txt": "./",
      "binaries/Calcpad.Server": "./",
      "binaries/createdump": "./",
      "binaries/template.html": "./",
      "binaries/Fonts/*": "./Fonts/",
      "binaries/bg/*": "./bg/",
      "binaries/zh/*": "./zh/"
    },
    "linux": {
      "deb": {
        "depends": [],
        "files": {
          "/usr/share/doc/CalcpadCE/copyright": "../../../../LICENSE",
          "/usr/share/doc/CalcpadCE/THIRD-PARTY-NOTICES.txt": "../../../../THIRD-PARTY-NOTICES.txt"
        }
      },
      "rpm": {
        "depends": [],
        "files": {
          "/usr/share/licenses/CalcpadCE/LICENSE": "../../../../LICENSE",
          "/usr/share/licenses/CalcpadCE/THIRD-PARTY-NOTICES.txt": "../../../../THIRD-PARTY-NOTICES.txt"
        }
      }
    }
  }
}
