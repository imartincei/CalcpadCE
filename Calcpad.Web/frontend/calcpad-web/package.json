{
  "name": "calcpad-web",
  "private": true,
  "description": "CalcpadCE web editor — Monaco + Vue sidebar powered by calcpad-frontend",
  "author": "CalcpadCE Contributors",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "node ../scripts/i18n/i18n.mjs --monaco-cache",
    "dev": "vite",
    "prebuild": "node ../scripts/i18n/i18n.mjs --monaco-cache",
    "build": "vite build",
    "prebuild:desktop": "node ../scripts/i18n/i18n.mjs --monaco-cache",
    "build:desktop": "vite build --mode desktop",
    "prebuild:watch": "node ../scripts/i18n/i18n.mjs --monaco-cache",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "check:contrast": "node ../scripts/check-contrast.mjs",
    "i18n": "node ../scripts/i18n/i18n.mjs",
    "i18n:check": "node ../scripts/i18n/i18n.mjs --check",
    "i18n:check-vscode": "node ../scripts/i18n/check-vscode-english.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-log": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-store": "^2",
    "calcpad-frontend": "file:../calcpad-frontend",
    "monaco-editor": "^0.52.0",
    "pdfjs-dist": "6.4.299",
    "vue": "^3.5.39",
    "vue-i18n": "^11.4.16"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "^5.9.0",
    "vite": "^8.1.3",
    "vue-tsc": "^3.3.13"
  }
}
