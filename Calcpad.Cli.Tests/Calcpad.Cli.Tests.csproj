<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Calcpad.Cli\Calcpad.Cli.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Copy only the framework-dependent runtime files. Tests can launch the same build
       regardless of their current directory or test configuration without example assets. -->
  <Target Name="CopyCliForIntegrationTests" AfterTargets="Build">
    <ItemGroup>
      <_CliFile Include="$(MSBuildThisFileDirectory)../Calcpad.Cli/bin/$(Configuration)/net10.0/**/*"
                Exclude="$(MSBuildThisFileDirectory)../Calcpad.Cli/bin/$(Configuration)/net10.0/Examples/**/*;$(MSBuildThisFileDirectory)../Calcpad.Cli/bin/$(Configuration)/net10.0/doc/**/*;$(MSBuildThisFileDirectory)../Calcpad.Cli/bin/$(Configuration)/net10.0/Syntax/**/*" />
    </ItemGroup>
    <RemoveDir Directories="$(OutDir)cli" />
    <Copy SourceFiles="@(_CliFile)"
          DestinationFiles="@(_CliFile->'$(OutDir)cli/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
