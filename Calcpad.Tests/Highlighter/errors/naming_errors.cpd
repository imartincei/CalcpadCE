' CPD-32xx: Naming errors
' CPD-3204: Variable conflicts with keyword
if = 1
for = 2

' Variable shadows unit (allowed, no error)
m = 5
kg = 10
s = 2

' CPD-3205: Variable conflicts with constant
e = 2.71

' CPD-3206: Function with no params
calc() = 43

' CPD-3207: Required parameter after optional parameter
reqAfterOpt(x = 1; y) = x + y
