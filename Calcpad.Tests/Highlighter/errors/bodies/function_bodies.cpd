' A custom function body is judged at its first call, which is marked and linked to the body
'expect: CPD-3301[fbA]->+2[f1(1)]
f1(x) = x + fbA
'expect: CPD-3301[f1(1)]->-2[fbA]
a1 = f1(1)
' Later calls are not marked
b1 = f1(2)
fbA = 3

' Defined before its first call, so nothing is marked
f2(x) = x + fbB
fbB = 1
a2 = f2(1)

' Never called, so only the body is marked
'expect: CPD-3301[fbC]
f3(x) = x + fbC

' Called through another function: the outer call is marked
'expect: CPD-3301[fbD]->+3[g4(1)]
f4(x) = x + fbD
g4(x) = 2*f4(x)
'expect: CPD-3301[g4(1)]->-3[fbD]
a4 = g4(1)

' Two functions with errors called on one line
'expect: CPD-3301[fbE]->+4[f5(1)]
f5(x) = x + fbE
'expect: CPD-3301[fbF]->+2[g5(1)]
g5(x) = x + fbF
'expect: CPD-3301[f5(1)]->-4[fbE], CPD-3301[g5(1)]->-2[fbF]
a5 = f5(1) + g5(1)

' A nested call marks the outer one
'expect: CPD-3301[fbG]->+2[f6(f6(1))]
f6(x) = x + fbG
'expect: CPD-3301[f6(f6(1))]->-2[fbG]
a6 = f6(f6(1))

' Called in a loop that defines the name later, so the next pass has it
f7(x) = x + fbH
#for i7 = 1 : 2
a7 = f7(i7)
fbH = i7
#loop

' Called in a loop that never defines it
'expect: CPD-3301[fbI]->+3[f8(i8)]
f8(x) = x + fbI
#for i8 = 1 : 2
'expect: CPD-3301[f8(i8)]->-3[fbI]
a8 = f8(i8)
#loop

' First called in a branch that does not run
'expect: CPD-3301[fbJ]->+3[f9(1)]
f9(x) = x + fbJ
#if 1 > 2
'expect: CPD-3301[f9(1)]->-3[fbJ]
a9 = f9(1)
#end if
b9 = f9(2)

' Called through a macro: the macro call is marked
#def call10$(x$) = f10(x$)
'expect: CPD-3301[fbK]->+2[call10\$(1)]
f10(x) = x + fbK
'expect: CPD-3301[call10\$(1)]->-2[fbK]
a10 = call10$(1)

' A body continued over several lines
'expect+1: CPD-3301[fbL]->+2[f11(1)]
f11(x) = x + _
fbL
'expect: CPD-3301[f11(1)]->-2[fbL]
a11 = f11(1)

' From an include, the body is on the #include line
'expect: CPD-3301[#include ../includes/body_lib.cpd]->+2[libBody(1)]
#include ../includes/body_lib.cpd
'expect: CPD-3301[libBody(1)]->-2[#include ../includes/body_lib.cpd]
a12 = libBody(1)
