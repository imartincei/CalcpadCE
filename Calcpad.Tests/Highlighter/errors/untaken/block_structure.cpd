' Block structure errors in branches that never run
x = 1
#if x > 100
'expect: CPD-5121[#for i = 1]
    #for i = 1
    #loop
'expect: CPD-5201[#if]
    #if
    #end if
'expect: CPD-5102[#while]
    #while
    #loop
#end if

' A duplicate #else in an #else branch that never runs
#if x > 0
    y = 1
#else
    #if x > 1
    #else
'expect: CPD-5202[#else]
    #else
    #end if
#end if

' #else if after #else in a branch that never runs
#if x < 0
    #if x > 1
    #else
'expect: CPD-5203[#else if x > 2]
    #else if x > 2
    #end if
#end if

' A stray #loop closes nothing in a branch that never runs
#if x > 100
'expect: CPD-3105[#loop]
    #loop
#end if
