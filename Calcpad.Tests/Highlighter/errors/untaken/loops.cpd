' Errors in loop bodies that never run
x = 1
#while x < 0
'expect: CPD-3301[undefinedWhile]
    a = undefinedWhile
'expect: CPD-3307[atan2(1)]
    b = atan2(1)
    x = x + 1
#loop

' A loop that repeats zero times
#repeat 0
'expect: CPD-3301[undefinedRepeat]
    c = undefinedRepeat
'expect: CPD-3404[=]
    d = 2 + c = 3
#loop

' Lines after #break never run
#repeat 3
    #break
'expect: CPD-3301[undefinedAfterBreak]
    f1 = undefinedAfterBreak
#loop

' A loop inside a branch that never runs
#if x > 100
    #for i = 1 : 3
'expect: CPD-3305[noFunc]
        g1 = noFunc(i)
'expect: CPD-3101[(]
        g2 = (i + 1
    #loop
#end if
