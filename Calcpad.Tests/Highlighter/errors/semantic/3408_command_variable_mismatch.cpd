' CPD-3408: the command expression does not use its own variable
'expect: CPD-3408[j^2 ], CPD-3301[j]
s = $Sum{j^2 @ k = 1 : 5}

' The other variable is defined
j = 2
'expect: CPD-3408[j*2 ]
p = $Product{j*2 @ k = 1 : 3}

' In a custom function
'expect: CPD-3408
f(n) = $Sum{n*2 @ i = 1 : 4}

' Inside $Block
'expect: CPD-3408
g(x) = $Block{a = x; $Sum{a*j @ m = 1 : 2}}
