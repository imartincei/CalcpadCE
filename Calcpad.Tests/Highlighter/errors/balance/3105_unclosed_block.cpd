' CPD-3105: unmatched opening brace or control block
'expect: CPD-3105
r = $Block{a = 1; a*2

' A command in a custom function
'expect: CPD-3105
f(n) = $Sum{k^2 @ k = 1 : n

' A command nested in another leaves the outer one open
'expect: CPD-3105
g(n) = $Inline{t = n; $Sum{k*t @ k = 1 : n}

' Block enders without a starter
'expect: CPD-3105[#end if]
#end if
'expect: CPD-3105[#loop]
#loop
'expect: CPD-3105[#else]
#else
'expect: CPD-3105
#else if 1 > 0

' A #loop that closes an #if
#repeat 2
#if 1 > 0
'expect: CPD-3105[#loop]
#loop
#end if

' A multi-line macro used inside a command splits it over lines
x = 1
#def show$
x
#end def
'expect: CPD-3105, CPD-3106
y = $Inline{show$}

' Blocks left open at the end of the file
'expect: CPD-3105[#for i = 1 : 3]
#for i = 1 : 3
'expect: CPD-3105
    #if i > 1
        z = i
