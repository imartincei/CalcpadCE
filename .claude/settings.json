{
  "permissions": {
    "allow": [
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(dotnet build:*)",
      "Bash(tree:*)",
      "WebSearch",
      "Bash(git ls-tree *)",
      "WebFetch(domain:v2.tauri.app)",
      "WebFetch(domain:github.com)",
      "Bash(export PATH=\"$HOME/.cargo/bin:$PATH\")",
      "Bash(cargo check *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-$PWD}/.claude/hooks/claude-md-reminder.sh\""
          }
        ]
      }
    ]
  }
}
